      skills: [
        { cat: "Game Audio",      items: ["FMOD Studio","Wwise","Adaptive Audio","Procedural Music","Param-Driven Design","Spatial Audio"] },
        { cat: "Engine & Tools",  items: ["Unity Audio","Logic Pro","Pro Tools","Reaper"] },
        { cat: "Film & Media",    items: ["Film Scoring","Foley","ADR","Mixing & Mastering"] },
      ]
    },
    {
      year: 2021, era: "Global Game Audio",
      synopsis: "First steps into global game audio freelancing — working with Gear Inc. and Tilting Point on globally-distributed IPs including Angry Birds and M&M's.",
      skills: [
        { cat: "Game Audio",      items: ["FMOD Studio","Adaptive Audio","Param-Driven Design","Mobile SFX"] },
        { cat: "Engine & Tools",  items: ["Unity Audio","Logic Pro","Pro Tools"] },
        { cat: "Film & Media",    items: ["Film Scoring","Foley","ADR","Mixing & Mastering"] },
      ]
    },
    {
