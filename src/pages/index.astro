  // ── MODE TOGGLE ──
  let darkMode = true;
  const modeToggleBtn = document.getElementById('mode-toggle');
  if (modeToggleBtn) modeToggleBtn.classList.add('mode-dark'); // dark mode on by default
  modeToggleBtn?.addEventListener('click', () => {
