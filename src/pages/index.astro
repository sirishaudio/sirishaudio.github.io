      const wrap = document.createElement('span');
      wrap.className = 'rm-year-digit-wrap';
      const col = document.createElement('span');
      col.className = 'rm-year-digit-col no-anim';
      for (let rep = 0; rep < 5; rep++)
        for (let n = 0; n <= 9; n++) {
          const s = document.createElement('span'); s.textContent = n; col.appendChild(s);
        }
      wrap.appendChild(col);
      rmYearEl.appendChild(wrap);
      rmYearDigitCols.push(col);
    }
  })();

  // direction: 'up' (newer), 'down' (older), null = snap
  function setYearOdometer(newYear, direction) {
    const newXX = String(newYear % 100).padStart(2, '0');

    if (direction === null) {
      for (let d = 0; d < 2; d++) {
        const digit = parseInt(newXX[d]);
        rmYearDigitCols[d].classList.add('no-anim');
        rmYearVirtualY[d] = -(20 + digit);
        rmYearDigitCols[d].style.transform = `translateY(${rmYearVirtualY[d]}em)`;
      }
      rmYearCurrent = newYear;
      return;
    }

    const oldXX      = String(rmYearCurrent % 100).padStart(2, '0');
    const tensChanged = oldXX[0] !== newXX[0];
    rmYearCurrent = newYear;

    for (let d = 0; d < 2; d++) {
      const col          = rmYearDigitCols[d];
      const curY         = rmYearVirtualY[d];
      const newDigit     = parseInt(newXX[d]);
      const digitChanged = oldXX[d] !== newXX[d];
      const doFullRev    = !digitChanged && d === 1 && tensChanged; // units spins if tens ticks

      if (!digitChanged && !doFullRev) continue; // truly unchanged — don't touch

      col.classList.remove('no-anim');
      let newY;

      if (doFullRev) {
        // Full 10-step revolution back to same digit
        newY = direction === 'up' ? curY - 10 : curY + 10;
      } else if (direction === 'up') {
        let c = -(20 + newDigit);
        while (c >= curY) c -= 10;
        newY = c;
      } else {
        let c = -(20 + newDigit);
        while (c <= curY) c += 10;
        newY = c;
      }

      rmYearVirtualY[d] = newY;
      col.style.transform = `translateY(${newY}em)`;

      clearTimeout(rmYearResetIds[d]);
      const snapY = -(20 + newDigit);
      rmYearResetIds[d] = setTimeout(() => {
        col.classList.add('no-anim');
        col.style.transform = `translateY(${snapY}em)`;
        rmYearVirtualY[d] = snapY;
        requestAnimationFrame(() => requestAnimationFrame(() => col.classList.remove('no-anim')));
      }, 460);
    }
  }


