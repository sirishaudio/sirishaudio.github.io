---
import Layout from "../layouts/Layout.astro";
import "../styles/global.css";

const gameSD = [
  { title: "Spongebob: Krusty Cook-Off", studio: "Nukebox Studios", year: "2018–2022", desc: "Parameter-driven adaptive music + SFX via Unity & FMOD. 29M+ downloads. Google Play Users' Choice 2020.", tags: ["FMOD","Unity","Adaptive Audio"], note: "100M+ players globally", ios: "https://apps.apple.com/app/spongebob-krusty-cook-off/id1456844652", android: "https://play.google.com/store/apps/details?id=com.nickelodeon.sponge" },
  { title: "Food Truck Chef", studio: "Nukebox Studios", year: "2018–2022", desc: "Full audio pipeline — adaptive music, SFX, and UI sounds for a globally distributed casual title.", tags: ["FMOD","Unity","SFX Pipeline"], note: "", ios: "https://apps.apple.com/app/food-truck-chef/id1213039508", android: "https://play.google.com/store/apps/details?id=com.socialpoint.foodtruckchef" },
