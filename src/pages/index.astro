      rmEraEl.textContent  = s.era;
      rmSynEl.textContent  = s.synopsis;
      rmSkillsEl.innerHTML = s.skills.map(c =>
        `<div class="roadmap-cat">
          <div class="roadmap-cat-label">${c.cat}</div>
          <div class="roadmap-tags">${c.items.map(t => `<span class="roadmap-tag">${t}</span>`).join('')}</div>
        </div>`
      ).join('');
      rmYearsCol.querySelectorAll('.rm-year-label').forEach((el, i) => el.classList.toggle('active', i === idx));
      // Sync knob visuals
      v2SnapVisuals(idx, rmKnobStops, rmKnobDots, rmIndicator, rmKnobProg, buildArcPath, 'rm-led-glow');
      rmKnobState.idx = idx;
      if (rmBody) rmBody.scrollTop = 0;
      rmCurrent = idx;
      rmPane.classList.remove('fading');
      requestAnimationFrame(() => {
        rmBody.style.setProperty('--rm-fade-top', '0%');
        const mx = rmBody.scrollHeight - rmBody.clientHeight;
        rmBody.style.setProperty('--rm-fade-bot', mx > 8 ? '88%' : '100%');
        if (rmGlowTop) rmGlowTop.classList.remove('visible');
        if (rmGlowBot) rmGlowBot.classList.toggle('visible', mx > 8);
      });
    }, 180);
  }

  // FADER UI — PARKED: track drag events (kept for future use)
  // let rmDragging = false;
  // function rmIdxFromY(clientY) { ... }
  // rmTrackZone.addEventListener('pointerdown', ...);
  // rmTrackZone.addEventListener('pointermove', ...);
  // rmTrackZone.addEventListener('pointerup',   ...);
  // rmTrackZone.addEventListener('pointercancel', ...);

  // Wire knob drag → year navigation (linear, no wrap)
  wireV2HorizDrag(rmKnobBody, rmKnobState, setRmStop, false);

  // Init
  (() => {
    const s = rmStops[0];
    setYearOdometer(s.year, null); // snap to initial position, no transition
    rmEraEl.textContent  = s.era;
    rmSynEl.textContent  = s.synopsis;
    rmSkillsEl.innerHTML = s.skills.map(c =>
      `<div class="roadmap-cat">
        <div class="roadmap-cat-label">${c.cat}</div>
        <div class="roadmap-tags">${c.items.map(t => `<span class="roadmap-tag">${t}</span>`).join('')}</div>
      </div>`
    ).join('');
    requestAnimationFrame(() => {
      v2SnapVisuals(0, rmKnobStops, rmKnobDots, rmIndicator, rmKnobProg, buildArcPath, 'rm-led-glow');
      // Enable odometer transitions after initial position is painted
      requestAnimationFrame(() => rmYearDigitCols.forEach(c => c.classList.remove('no-anim')));
