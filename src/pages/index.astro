<script>
  // ── PARALLAX ──
  const heroBg = document.getElementById('hero-bg');
  const heroContent = document.getElementById('hero-content');
  const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (!prefersReduced) {
    window.addEventListener('scroll', () => {
      const y = window.scrollY;
      if (heroBg) heroBg.style.transform = `translateY(${y * 0.45}px)`;
      if (heroContent) heroContent.style.transform = `translateY(${y * 0.15}px)`;
    }, { passive: true });
  }

  // ── SCROLL REVEAL ──
  const revealEls = document.querySelectorAll('.reveal');
  const revealObs = new IntersectionObserver((entries) => {
    entries.forEach(e => { if (e.isIntersecting) { e.target.classList.add('visible'); revealObs.unobserve(e.target); } });
  }, { threshold: 0.08 });
  revealEls.forEach(el => revealObs.observe(el));

  // ── SHARED KNOB STATE ──
  // isModalOpen: guards all knob scroll-update handlers so indicator freezes in place while a card is open.
  // Inactive (no-scroll) state is separate: indicator parks at 0°, dashed arc shown.
  // Future knob instances must respect both flags.
  let isModalOpen = false;

  // ── WORK: CATEGORY SWITCHING + SCROLL GLOWS ──
  const workBtns   = document.querySelectorAll('.work-btn');
  const workPanels = document.querySelectorAll('.work-panel');
  const workPanelsWrap = document.getElementById('work-panels');
  const wglLeft    = document.getElementById('wgl-left');
  const wglRight   = document.getElementById('wgl-right');
  let workCurrent  = 0;

  function getActiveTrack() {
    return workPanels[workCurrent];
  }

  function updateWorkGlows() {
    const track = getActiveTrack();
    if (!track) return;
    const sl  = track.scrollLeft;
    const max = track.scrollWidth - track.clientWidth;
    const showLeft  = sl > 8;
    const showRight = max > 8 && sl < max - 8;
    if (wglLeft)  wglLeft.classList.toggle('visible',  showLeft);
    if (wglRight) wglRight.classList.toggle('visible', showRight);
    if (workPanelsWrap) {
      workPanelsWrap.style.setProperty('--fl', showLeft  ? 'transparent' : 'black');
      workPanelsWrap.style.setProperty('--fr', showRight ? 'transparent' : 'black');
    }
  }

  workPanels.forEach(panel => {
    panel.addEventListener('scroll', updateWorkGlows, { passive: true });
  });

  function setWorkCat(idx) {
    if (idx === workCurrent) return;
    workPanelsWrap.classList.add('fading');
    // Reset glow state immediately
    if (wglLeft)  wglLeft.classList.remove('visible');
    if (wglRight) wglRight.classList.remove('visible');
    if (workPanelsWrap) {
      workPanelsWrap.style.setProperty('--fl', 'black');
      workPanelsWrap.style.setProperty('--fr', 'transparent');
    }
    setTimeout(() => {
      workBtns.forEach((b, i)   => b.classList.toggle('active', i === idx));
      workPanels.forEach((p, i) => p.classList.toggle('active', i === idx));
      workPanelsWrap.classList.remove('fading');
      workCurrent = idx;
      requestAnimationFrame(() => {
        updateWorkGlows();
        setWkKnobState(workPanels[workCurrent]);
      });
    }, 150);
  }

  workBtns.forEach((btn, i) => btn.addEventListener('click', () => setWorkCat(i)));

  // ── WORK KNOB ──
  const wkSvg          = document.getElementById('work-knob-svg');
  const wkDotsGroup    = document.getElementById('wk-dots-group');
  const wkProgress     = document.getElementById('wk-progress');
  const wkInactiveArc  = document.getElementById('wk-inactive-arc');
  const wkIndicator    = document.getElementById('wk-indicator');
  const wkIndicatorLine = document.getElementById('wk-indicator-line');
  const wkIndicatorDot  = document.getElementById('wk-indicator-dot');
  const wkKnobBody     = document.getElementById('wk-knob-body');
  let wkActive = false;
  let wkCardIdx = 0;
  let wkIsAnimating = false;

  function wkGetStops(n) {
    if (n <= 1) return [300];
    return Array.from({ length: n }, (_, i) => 300 + i * 120 / (n - 1));
  }

  function buildWkDots(panel) {
    if (!wkDotsGroup) return false;
    wkDotsGroup.innerHTML = '';
    const scrollable = panel.scrollWidth > panel.clientWidth + 4;
    if (!scrollable) {
      const rect = document.createElementNS('http://www.w3.org/2000/svg', 'rect');
      rect.setAttribute('x', '56'); rect.setAttribute('y', '6.5');
      rect.setAttribute('width', '48'); rect.setAttribute('height', '7');
      rect.setAttribute('rx', '3.5');
      rect.setAttribute('fill', '#243D55'); rect.setAttribute('stroke', '#243447'); rect.setAttribute('stroke-width', '0.5');
      wkDotsGroup.appendChild(rect);
      return false;
    }
    const n = panel.querySelectorAll('.proj-card-v').length;
    const startX = 80 - (n - 1) * 14;
    for (let i = 0; i < n; i++) {
      const c = document.createElementNS('http://www.w3.org/2000/svg', 'circle');
      c.setAttribute('cx', String(startX + i * 28));
      c.setAttribute('cy', '10'); c.setAttribute('r', '3.5');
      c.setAttribute('fill', '#243D55'); c.setAttribute('stroke', '#243447'); c.setAttribute('stroke-width', '0.5');
      c.dataset.wkDot = String(i); c.style.cursor = 'pointer';
      wkDotsGroup.appendChild(c);
    }
    return true;
  }

  // Instant visual snap — used by scroll-driven updates (no animation lock)
  function wkSnapVisuals(idx, stops, dots) {
    wkCardIdx = idx;
    if (wkIndicator) wkIndicator.style.transform = `rotate(${stops[idx]}deg)`;
    const sweep = stops[idx] - 300;
    if (wkProgress) wkProgress.setAttribute('d', sweep > 0.5 ? buildArcPath(300, sweep) : '');
    dots.forEach((d, i) => {
      if (i === idx) {
        d.setAttribute('fill', '#3A8A65'); d.setAttribute('stroke', '#2D6A4F'); d.setAttribute('filter', 'url(#wk-led-glow)');
      } else {
        d.setAttribute('fill', '#243D55'); d.setAttribute('stroke', '#243447'); d.removeAttribute('filter');
      }
    });
  }

  function setWkKnobState(panel) {
    const scrollable = buildWkDots(panel);
    wkActive = scrollable; wkCardIdx = 0;
    if (!scrollable) {
      if (wkProgress)      { wkProgress.setAttribute('d', ''); wkProgress.style.display = 'none'; }
      if (wkInactiveArc)   wkInactiveArc.style.display = '';
      if (wkIndicator)     wkIndicator.style.transform = 'rotate(0deg)';
      if (wkIndicatorLine) wkIndicatorLine.setAttribute('stroke', '#243447');
      if (wkIndicatorDot)  wkIndicatorDot.setAttribute('fill', '#4a5f78');
      if (wkKnobBody)      wkKnobBody.setAttribute('stroke', '#1C2B3A');
    } else {
      if (wkInactiveArc)   wkInactiveArc.style.display = 'none';
      if (wkProgress)      wkProgress.style.display = '';
      if (wkIndicatorLine) wkIndicatorLine.setAttribute('stroke', '#8A9BB0');
      if (wkIndicatorDot)  wkIndicatorDot.setAttribute('fill', '#3A8A65');
      if (wkKnobBody)      wkKnobBody.setAttribute('stroke', '#243447');
      const dots = Array.from(wkDotsGroup.querySelectorAll('circle'));
      wkSnapVisuals(0, wkGetStops(dots.length), dots);
    }
  }

  // Stepped animation — reel standard, clamped (no wrap on long panels)
  async function wkGoTo(target) {
    if (wkIsAnimating || !wkActive || isModalOpen) return;
    const panel = workPanels[workCurrent];
    if (!panel) return;
    const dots = Array.from(wkDotsGroup.querySelectorAll('circle'));
    const n = dots.length; if (n <= 1) return;
    const stops = wkGetStops(n);
    target = Math.max(0, Math.min(n - 1, target));
    if (target === wkCardIdx) return;
    wkIsAnimating = true;

    const steps = Math.abs(target - wkCardIdx);
    const msPerStep = Math.round(350 / steps);
    const firstCard = panel.querySelector('.proj-card-v');
    const cardStep = firstCard ? firstCard.offsetWidth + 20 : 267;
    panel.scrollTo({ left: target * cardStep, behavior: 'smooth' });
    if (wkIndicator) wkIndicator.style.transitionDuration = `${msPerStep}ms`;

    try {
      const dir = target > wkCardIdx ? 1 : -1;
      while (wkCardIdx !== target) {
        wkCardIdx += dir;
        wkSnapVisuals(wkCardIdx, stops, dots);
        if (wkCardIdx !== target) await sleep(msPerStep);
      }
    } finally {
      if (wkIndicator) wkIndicator.style.transitionDuration = '';
      wkIsAnimating = false;
    }
  }

  // Scroll → discrete snap (no animation — free scroll follows naturally)
  workPanels.forEach(panel => {
    panel.addEventListener('scroll', () => {
      updateWorkGlows();
      if (!wkActive || isModalOpen || wkIsAnimating) return;
      const dots = Array.from(wkDotsGroup.querySelectorAll('circle'));
      const n = dots.length; if (!n) return;
      const max = panel.scrollWidth - panel.clientWidth;
      const newIdx = max > 0 ? Math.min(n - 1, Math.round(panel.scrollLeft / max * (n - 1))) : 0;
      if (newIdx !== wkCardIdx) wkSnapVisuals(newIdx, wkGetStops(n), dots);
    }, { passive: true });
  });

