      rmBody.style.setProperty('--rm-fade-bot', maxInit > 8 ? '88%' : '100%');
      if (rmGlowBot) rmGlowBot.classList.toggle('visible', maxInit > 8);
    });
  })();

  // Knob drag
  const knobSvg = document.getElementById('knob-svg');
  let isDragging = false, dragX = 0, dragAccum = 0;
  if (knobSvg) {
    knobSvg.addEventListener('mousedown', e => { isDragging = true; dragX = e.clientX; dragAccum = 0; e.preventDefault(); });
    knobSvg.addEventListener('touchstart', e => { isDragging = true; dragX = e.touches[0].clientX; dragAccum = 0; }, { passive: true });
    document.addEventListener('mousemove', e => {
      if (!isDragging) return;
      dragAccum += (e.clientX - dragX) * 0.6; dragX = e.clientX;
      const t = Math.max(0, Math.min(4, Math.round(currentReel + dragAccum / 45)));
      if (t !== currentReel) { dragAccum = 0; goToReel(t); }
    });
    document.addEventListener('touchmove', e => {
      if (!isDragging) return;
      e.preventDefault();
      dragAccum += (e.touches[0].clientX - dragX) * 0.6; dragX = e.touches[0].clientX;
      const t = Math.max(0, Math.min(4, Math.round(currentReel + dragAccum / 45)));
      if (t !== currentReel) { dragAccum = 0; goToReel(t); }
    }, { passive: false });
    document.addEventListener('mouseup', () => { isDragging = false; });
    document.addEventListener('touchend', () => { isDragging = false; });
  }

  // ── CARD EXPAND MODAL ──
  const cardModal = document.getElementById('card-modal');
  const cardModalClose = document.getElementById('card-modal-close');

  function openCardModal(card) {
    const cc = getComputedStyle(card).getPropertyValue('--cc').trim();

    // Thumb area
    const thumbBg = document.getElementById('cm-thumb-bg');
    if (thumbBg) thumbBg.style.background = card.dataset.thumbBg || '';
    const thumbIcon = document.getElementById('cm-thumb-icon');
    if (thumbIcon) thumbIcon.textContent = card.dataset.icon || '';
    const thumbLabel = document.getElementById('cm-thumb-label');
    if (thumbLabel) { thumbLabel.textContent = card.dataset.label || ''; thumbLabel.style.color = cc; }
    const accentEl = document.getElementById('cm-accent');
    if (accentEl) accentEl.style.background = cc;

    // Note badge
    const noteEl = document.getElementById('cm-note');
    if (noteEl) { noteEl.textContent = card.dataset.note || ''; noteEl.style.color = cc; noteEl.style.borderColor = cc; }

    // Meta + body
    const studioEl = document.getElementById('cm-studio');
    if (studioEl) studioEl.textContent = card.dataset.studio || '';
    const yearEl = document.getElementById('cm-year');
    if (yearEl) yearEl.textContent = card.dataset.year || '';
    const titleEl = document.getElementById('cm-title');
    if (titleEl) titleEl.textContent = card.dataset.title || '';
    const descEl = document.getElementById('cm-desc');
    if (descEl) descEl.textContent = card.dataset.desc || '';

    // Tags
    const tagsEl = document.getElementById('cm-tags');
    if (tagsEl) {
      tagsEl.innerHTML = '';
      (card.dataset.tags || '').split(',').filter(Boolean).forEach(t => {
        const span = document.createElement('span');
        span.className = 'cm-tag';
        span.textContent = t.trim();
        tagsEl.appendChild(span);
      });
    }

    // Store links
    const iosEl = document.getElementById('cm-link-ios');
    const androidEl = document.getElementById('cm-link-android');
    const ios = card.dataset.ios || '';
    const android = card.dataset.android || '';
    if (iosEl) { if (ios) { iosEl.href = ios; iosEl.hidden = false; } else { iosEl.hidden = true; } }
    if (androidEl) { if (android) { androidEl.href = android; androidEl.hidden = false; } else { androidEl.hidden = true; } }

    cardModal.setAttribute('aria-hidden', 'false');
    cardModal.classList.add('open');
    document.body.style.overflow = 'hidden';
    isModalOpen = true;
  }

  function closeCardModal() {
    cardModal.classList.remove('open');
    cardModal.setAttribute('aria-hidden', 'true');
    document.body.style.overflow = '';
    isModalOpen = false;
  }

  if (cardModal) {
    cardModal.addEventListener('click', e => { if (e.target === cardModal) closeCardModal(); });
  }
  if (cardModalClose) {
    cardModalClose.addEventListener('click', closeCardModal);
  }
  document.addEventListener('keydown', e => { if (e.key === 'Escape') closeCardModal(); });

  document.querySelectorAll('.proj-card-v').forEach(card => {
    card.addEventListener('click', () => openCardModal(card));
  });

  // ── LISTEN: SC WIDGET PLAYERS ──
  function fmtTime(ms) {
    const s = Math.floor(ms / 1000);
    return `${Math.floor(s / 60)}:${String(s % 60).padStart(2, '0')}`;
  }

  const lcCards = document.querySelectorAll('.listen-card');
  const lcWidgets = [];

  lcCards.forEach((card, idx) => {
    const iframe   = card.querySelector('.lc-sc-iframe');
    const playBtn  = card.querySelector('.lc-play-btn');
    const fill     = card.querySelector('.lc-progress-fill');
    const bar      = card.querySelector('.lc-progress-bar');
    const timeCur  = card.querySelector('.lc-time-cur');
    const timeDur  = card.querySelector('.lc-time-dur');

    const widget = SC.Widget(iframe);
    lcWidgets[idx] = widget;
    let duration = 0;

    widget.bind(SC.Widget.Events.READY, () => {
      widget.getDuration(d => { duration = d; timeDur.textContent = fmtTime(d); });
    });

    widget.bind(SC.Widget.Events.PLAY, () => {
      playBtn.classList.add('playing');
      // pause all other cards
      lcWidgets.forEach((w, i) => {
        if (i !== idx) {
          w.pause();
          lcCards[i].querySelector('.lc-play-btn').classList.remove('playing');
        }
      });
    });

    widget.bind(SC.Widget.Events.PAUSE, () => {
      playBtn.classList.remove('playing');
    });

    widget.bind(SC.Widget.Events.FINISH, () => {
      playBtn.classList.remove('playing');
      fill.style.width = '0%';
      timeCur.textContent = '0:00';
      widget.seekTo(0); // enables replay
    });

    widget.bind(SC.Widget.Events.PLAY_PROGRESS, (data) => {
      fill.style.width = (data.relativePosition * 100) + '%';
      timeCur.textContent = fmtTime(data.currentPosition);
    });

    playBtn.addEventListener('click', () => {
      if (playBtn.classList.contains('playing')) widget.pause();
      else widget.play();
    });

    bar.addEventListener('click', (e) => {
      const rect = bar.getBoundingClientRect();
      const pct  = Math.max(0, Math.min(1, (e.clientX - rect.left) / rect.width));
      widget.seekTo(pct * duration);
    });
  });

  // ── LISTEN KNOB ──
  (function() {
    const LC_COUNT      = document.querySelectorAll('.listen-card').length;
    const LC_SWEEP      = 120;                 // degrees total
    const LC_ARC_START  = 300;
    const LC_STEP       = LC_COUNT > 1 ? LC_SWEEP / (LC_COUNT - 1) : 0;
    const LC_STOPS      = Array.from({ length: LC_COUNT }, (_, i) => LC_ARC_START + i * LC_STEP);

    // Build dots in SVG
    const lcDotsGroup = document.getElementById('lc-dots-group');
    const DOT_GAP = 28, DOT_Y = 10;
    const lcDotStartX = 80 - (LC_COUNT - 1) * DOT_GAP / 2;
    const lcDotEls = LC_STOPS.map((_, i) => {
      const c = document.createElementNS('http://www.w3.org/2000/svg', 'circle');
      c.setAttribute('r', '3.5');
      c.setAttribute('cx', (lcDotStartX + i * DOT_GAP).toFixed(2));
      c.setAttribute('cy', DOT_Y);
      c.setAttribute('stroke-width', '0.5');
      c.style.cursor = 'pointer';
      c.dataset.index = String(i);
      lcDotsGroup.appendChild(c);
      return c;
    });

    const lcIndicator = document.getElementById('lc-indicator');
    const lcProgress  = document.getElementById('lc-progress');
    const lcTray      = document.querySelector('.listen-cards');
    const lcCardEls   = document.querySelectorAll('.listen-card');
    let lcIdx = 0;
    let lcIsAnimating = false;

    function lcP2xy(r, deg) {
      const rad = (deg - 90) * Math.PI / 180;
      return { x: 80 + r * Math.cos(rad), y: 72 + r * Math.sin(rad) };
    }
    function lcArcPath(startDeg, sweepDeg) {
      if (sweepDeg <= 0.5) return '';
      const s = lcP2xy(42, startDeg), e = lcP2xy(42, startDeg + sweepDeg);
      return `M ${s.x.toFixed(2)} ${s.y.toFixed(2)} A 42 42 0 ${sweepDeg > 180 ? 1 : 0} 1 ${e.x.toFixed(2)} ${e.y.toFixed(2)}`;
    }

    // Instant snap — used by scroll-driven updates and as the per-step primitive inside lcGoTo
    function lcSnapVisuals(idx) {
      lcIdx = idx;
      if (lcIndicator) lcIndicator.style.transform = `rotate(${LC_STOPS[idx]}deg)`;
      if (lcProgress) lcProgress.setAttribute('d', idx === 0 ? '' : lcArcPath(LC_ARC_START, LC_STOPS[idx] - LC_ARC_START));
      lcDotEls.forEach((d, i) => {
        if (i === idx) {
          d.setAttribute('fill', '#3A8A65'); d.setAttribute('stroke', '#2D6A4F'); d.setAttribute('filter', 'url(#lc-led-glow)');
        } else {
          d.setAttribute('fill', '#243D55'); d.setAttribute('stroke', '#243447'); d.removeAttribute('filter');
        }
      });
    }

    function lcScrollToCard(idx) {
      if (!lcTray || !lcCardEls[idx]) return;
      const card = lcCardEls[idx];
      lcTray.scrollTo({ top: card.offsetTop - lcTray.offsetTop, behavior: 'smooth' });
    }

    // Stepped animation — reel standard + wrap
    async function lcGoTo(target) {
      if (lcIsAnimating || isModalOpen) return;
      const norm = ((target % LC_COUNT) + LC_COUNT) % LC_COUNT;
      if (norm === lcIdx) return;
      lcIsAnimating = true;

      const wrappingForward  = lcIdx === LC_COUNT - 1 && norm === 0;
      const wrappingBackward = lcIdx === 0 && norm === LC_COUNT - 1;
      const steps = (wrappingForward || wrappingBackward) ? LC_COUNT - 1 : Math.abs(norm - lcIdx);
      const msPerStep = Math.round(350 / steps);

      lcScrollToCard(norm); // start scroll immediately, concurrent with knob
      if (lcIndicator) lcIndicator.style.transitionDuration = `${msPerStep}ms`;

      try {
        if (wrappingForward) {
          // Dots snap to 0; knob rewinds LC_COUNT-1 → 0
          lcDotEls.forEach((d, i) => {
            const a = i === 0;
            d.setAttribute('fill', a ? '#3A8A65' : '#243D55'); d.setAttribute('stroke', a ? '#2D6A4F' : '#243447');
            if (a) d.setAttribute('filter', 'url(#lc-led-glow)'); else d.removeAttribute('filter');
          });
          for (let i = LC_COUNT - 2; i >= 0; i--) {
            if (lcIndicator) lcIndicator.style.transform = `rotate(${LC_STOPS[i]}deg)`;
            if (lcProgress) lcProgress.setAttribute('d', i === 0 ? '' : lcArcPath(LC_ARC_START, LC_STOPS[i] - LC_ARC_START));
            await sleep(msPerStep);
          }
          lcIdx = 0;
        } else if (wrappingBackward) {
          // Dots snap to LC_COUNT-1; knob winds forward 0 → LC_COUNT-1
          lcDotEls.forEach((d, i) => {
            const a = i === LC_COUNT - 1;
            d.setAttribute('fill', a ? '#3A8A65' : '#243D55'); d.setAttribute('stroke', a ? '#2D6A4F' : '#243447');
            if (a) d.setAttribute('filter', 'url(#lc-led-glow)'); else d.removeAttribute('filter');
          });
          for (let i = 1; i < LC_COUNT; i++) {
            if (lcIndicator) lcIndicator.style.transform = `rotate(${LC_STOPS[i]}deg)`;
            if (lcProgress) lcProgress.setAttribute('d', lcArcPath(LC_ARC_START, LC_STOPS[i] - LC_ARC_START));
            await sleep(msPerStep);
          }
          lcIdx = LC_COUNT - 1;
        } else {
          const dir = norm > lcIdx ? 1 : -1;
          while (lcIdx !== norm) {
            lcIdx += dir;
            lcSnapVisuals(lcIdx);
            if (lcIdx !== norm) await sleep(msPerStep);
          }
        }
      } finally {
        if (lcIndicator) lcIndicator.style.transitionDuration = '';
        lcIsAnimating = false;
      }
    }

    // Scroll → instant snap (guards animation + modal)
    let lcScrollTicking = false;
    if (lcTray) {
      lcTray.addEventListener('scroll', () => {
        if (lcScrollTicking) return;
        lcScrollTicking = true;
        requestAnimationFrame(() => {
          if (!isModalOpen && !lcIsAnimating) {
            const max = lcTray.scrollHeight - lcTray.clientHeight;
            const newIdx = max > 0 ? Math.min(LC_COUNT - 1, Math.round(lcTray.scrollTop / max * (LC_COUNT - 1))) : 0;
            if (newIdx !== lcIdx) lcSnapVisuals(newIdx);
          }
          lcScrollTicking = false;
        });
      });
    }

    // Dot clicks
    lcDotEls.forEach((dot) => {
      dot.addEventListener('click', () => lcGoTo(Number(dot.dataset.index)));
    });

    // Drag → 45px/stop, stepped, wraps at boundaries
    const lcKnobBody = document.getElementById('lc-knob-body');
    if (lcKnobBody) {
      let lcDragging = false, lcDragX = 0, lcDragAccum = 0;
      lcKnobBody.addEventListener('mousedown', (e) => {
        lcDragging = true; lcDragX = e.clientX; lcDragAccum = 0; e.preventDefault();
      });
      lcKnobBody.addEventListener('touchstart', (e) => {
        lcDragging = true; lcDragX = e.touches[0].clientX; lcDragAccum = 0;
      }, { passive: true });
      document.addEventListener('mousemove', (e) => {
        if (!lcDragging) return;
        lcDragAccum += (e.clientX - lcDragX) * 0.6; lcDragX = e.clientX;
        const raw = Math.round(lcIdx + lcDragAccum / 45);
        const t = raw < 0 ? LC_COUNT - 1 : raw >= LC_COUNT ? 0 : raw;
        if (t !== lcIdx) { lcDragAccum = 0; lcGoTo(t); }
      });
      document.addEventListener('touchmove', (e) => {
        if (!lcDragging) return; e.preventDefault();
        lcDragAccum += (e.touches[0].clientX - lcDragX) * 0.6; lcDragX = e.touches[0].clientX;
        const raw = Math.round(lcIdx + lcDragAccum / 45);
        const t = raw < 0 ? LC_COUNT - 1 : raw >= LC_COUNT ? 0 : raw;
        if (t !== lcIdx) { lcDragAccum = 0; lcGoTo(t); }
      }, { passive: false });
      document.addEventListener('mouseup', () => { lcDragging = false; });
      document.addEventListener('touchend', () => { lcDragging = false; });
    }

    lcSnapVisuals(0);
  })();

  // ══════════════════════════════════════════════════
  //  V2 / V3 CAROUSEL CONTROLLERS
  //  All follow the KnobUI prefab spec (prefab_knob_behavior.md)
  //  Shared helpers: buildArcPath, p2xy, sleep already defined above.
  // ══════════════════════════════════════════════════

  // ── Shared V2 knob builder ──
  // Builds N dots (r=3.5, 28px spacing, centered x=80) into a <g> element.
  // Returns array of circle elements.
  function buildV2Dots(groupEl, n, ledGlowId) {
    groupEl.innerHTML = '';
    if (!n) return [];
    const startX = 80 - (n - 1) * 14;
    return Array.from({ length: n }, (_, i) => {
      const c = document.createElementNS('http://www.w3.org/2000/svg', 'circle');
      c.setAttribute('r', '3.5');
      c.setAttribute('cx', (startX + i * 28).toFixed(2));
      c.setAttribute('cy', '10');
      c.setAttribute('stroke-width', '0.5');
      c.style.cursor = 'pointer';
      c.dataset.index = String(i);
      if (i === 0) {
        c.setAttribute('fill', '#3A8A65'); c.setAttribute('stroke', '#2D6A4F');
        c.setAttribute('filter', `url(#${ledGlowId})`);
      } else {
        c.setAttribute('fill', '#243D55'); c.setAttribute('stroke', '#243447');
      }
      groupEl.appendChild(c);
      return c;
    });
  }

  // Shared V2 stop angle calculator (same formula as prefab)
  function v2GetStops(n) {
    if (n <= 1) return [300];
    return Array.from({ length: n }, (_, i) => 300 + i * 120 / (n - 1));
  }

  // Shared V2 snap visuals (instant, no animation)
  function v2SnapVisuals(idx, stops, dots, indicator, progress, arcFn, ledGlowId) {
    if (indicator) indicator.style.transform = `rotate(${stops[idx]}deg)`;
    if (progress)  progress.setAttribute('d', idx === 0 ? '' : arcFn(300, stops[idx] - 300));
    dots.forEach((d, i) => {
      if (i === idx) {
        d.setAttribute('fill', '#3A8A65'); d.setAttribute('stroke', '#2D6A4F');
        d.setAttribute('filter', `url(#${ledGlowId})`);
      } else {
        d.setAttribute('fill', '#243D55'); d.setAttribute('stroke', '#243447');
        d.removeAttribute('filter');
      }
    });
  }

  // Shared V2 stepped goto — horizontal carousels (reel-style, with wrap)
  async function v2GoToWrapped(target, state) {
    if (state.isAnimating || isModalOpen) return;
    const n = state.dots.length; if (n <= 1) return;
    const norm = ((target % n) + n) % n;
    if (norm === state.idx) return;
    state.isAnimating = true;
    const wrappingFwd = state.idx === n - 1 && norm === 0;
    const wrappingBwd = state.idx === 0 && norm === n - 1;
    const steps = (wrappingFwd || wrappingBwd) ? n - 1 : Math.abs(norm - state.idx);
    const msPerStep = Math.round(350 / steps);
    if (state.indicator) state.indicator.style.transitionDuration = `${msPerStep}ms`;
    // Scroll carousel to target card
    if (state.scrollFn) {
      state.scrollFn(norm);
    } else if (state.infinite) {
      const slot = state.infinite.getSlot();
      const vert = state.infinite.isVertical;
      // Wrap transitions scroll to the clone for visual continuity; normal moves use (idx+1)
      const si = wrappingFwd ? n + 1 : wrappingBwd ? 0 : norm + 1;
      state.track.scrollTo({ [vert ? 'top' : 'left']: si * slot, behavior: 'smooth' });
    } else {
      const slotW = state.cardEls[0] ? state.cardEls[0].offsetWidth + parseFloat(getComputedStyle(state.track).gap || '0') : 0;
      state.track.scrollTo({ left: norm * slotW, behavior: 'smooth' });
    }
    try {
      if (wrappingFwd) {
        // Dots snap to 0; knob rewinds n-1 → 0
        state.dots.forEach((d, i) => {
          const a = i === 0;
          d.setAttribute('fill', a ? '#3A8A65' : '#243D55');
          d.setAttribute('stroke', a ? '#2D6A4F' : '#243447');
          if (a) d.setAttribute('filter', `url(#${state.ledGlowId})`); else d.removeAttribute('filter');
        });
        for (let i = n - 2; i >= 0; i--) {
          if (state.indicator) state.indicator.style.transform = `rotate(${state.stops[i]}deg)`;
          if (state.progress)  state.progress.setAttribute('d', i === 0 ? '' : buildArcPath(300, state.stops[i] - 300));
          await sleep(msPerStep);
        }
        state.idx = 0;
      } else if (wrappingBwd) {
        // Dots snap to n-1; knob winds 0 → n-1
        state.dots.forEach((d, i) => {
          const a = i === n - 1;
          d.setAttribute('fill', a ? '#3A8A65' : '#243D55');
          d.setAttribute('stroke', a ? '#2D6A4F' : '#243447');
          if (a) d.setAttribute('filter', `url(#${state.ledGlowId})`); else d.removeAttribute('filter');
        });
        for (let i = 1; i < n; i++) {
          if (state.indicator) state.indicator.style.transform = `rotate(${state.stops[i]}deg)`;
          if (state.progress)  state.progress.setAttribute('d', buildArcPath(300, state.stops[i] - 300));
          await sleep(msPerStep);
        }
        state.idx = n - 1;
      } else {
        const dir = norm > state.idx ? 1 : -1;
        while (state.idx !== norm) {
          state.idx += dir;
          v2SnapVisuals(state.idx, state.stops, state.dots, state.indicator, state.progress, buildArcPath, state.ledGlowId);
          if (state.idx !== norm) await sleep(msPerStep);
        }
      }
    } finally {
      if (state.indicator) state.indicator.style.transitionDuration = '';
      state.isAnimating = false;
    }
  }

  // Shared V2 stepped goto — clamped (no wrap): Work V2
  async function v2GoToClamped(target, state) {
    if (state.isAnimating || !state.active || isModalOpen) return;
    const n = state.dots.length; if (n <= 1) return;
    target = Math.max(0, Math.min(n - 1, target));
    if (target === state.idx) return;
    state.isAnimating = true;
    const steps = Math.abs(target - state.idx);
    const msPerStep = Math.round(350 / steps);
    if (state.indicator) state.indicator.style.transitionDuration = `${msPerStep}ms`;
    const slotW = state.cardEls[0] ? state.cardEls[0].offsetWidth + parseFloat(getComputedStyle(state.track).gap || '0') : 0;
    state.track.scrollTo({ left: target * slotW, behavior: 'smooth' });
    try {
      const dir = target > state.idx ? 1 : -1;
      while (state.idx !== target) {
        state.idx += dir;
        v2SnapVisuals(state.idx, state.stops, state.dots, state.indicator, state.progress, buildArcPath, state.ledGlowId);
        if (state.idx !== target) await sleep(msPerStep);
      }
    } finally {
      if (state.indicator) state.indicator.style.transitionDuration = '';
      state.isAnimating = false;
    }
  }

  // Shared drag wiring for horizontal V2 carousels
  function wireV2HorizDrag(knobBody, state, goFn, wrapAtBounds) {
    if (!knobBody) return;
    let dragging = false, dragX = 0, dragAccum = 0;
    knobBody.addEventListener('mousedown', (e) => { dragging = true; dragX = e.clientX; dragAccum = 0; e.preventDefault(); });
    knobBody.addEventListener('touchstart', (e) => { dragging = true; dragX = e.touches[0].clientX; dragAccum = 0; }, { passive: true });
    document.addEventListener('mousemove', (e) => {
      if (!dragging) return;
      dragAccum += (e.clientX - dragX) * 0.6; dragX = e.clientX;
      const n = state.dots.length;
      const raw = Math.round(state.idx + dragAccum / 45);
      const t = wrapAtBounds
        ? (raw < 0 ? n - 1 : raw >= n ? 0 : raw)
        : Math.max(0, Math.min(n - 1, raw));
      if (t !== state.idx) { dragAccum = 0; goFn(t); }
    });
    document.addEventListener('touchmove', (e) => {
      if (!dragging) return;
      dragAccum += (e.touches[0].clientX - dragX) * 0.6; dragX = e.touches[0].clientX;
      const n = state.dots.length;
      const raw = Math.round(state.idx + dragAccum / 45);
      const t = wrapAtBounds
        ? (raw < 0 ? n - 1 : raw >= n ? 0 : raw)
        : Math.max(0, Math.min(n - 1, raw));
      if (t !== state.idx) { dragAccum = 0; goFn(t); }
    }, { passive: true });
    document.addEventListener('mouseup', () => { dragging = false; });
    document.addEventListener('touchend', () => { dragging = false; });
  }

  // Track-level edge wrap: swipe/drag past last/first card → wrap via goFn
  function wireV2TrackEdgeWrap(track, state, goFn, isVertical) {
    if (!track) return;
    const key = isVertical ? 'clientY' : 'clientX';
    let s0 = 0, mouseDown = false;
    const onStart = (pos) => { s0 = pos; };
    const onEnd   = (pos) => {
      const delta = pos - s0;
      if (Math.abs(delta) < 25 || state.isAnimating || isModalOpen) return;
      const n = state.dots.length; if (n <= 1) return;
      const sp  = isVertical ? track.scrollTop  : track.scrollLeft;
      const max = isVertical ? (track.scrollHeight - track.clientHeight) : (track.scrollWidth - track.clientWidth);
      // Swiped "next" at last card → wrap to first
      if (delta < 0 && sp >= max - 5 && state.idx === n - 1) goFn(0);
      // Swiped "prev" at first card → wrap to last
      if (delta > 0 && sp <=     5   && state.idx === 0)     goFn(n - 1);
    };
    track.addEventListener('touchstart', (e) => onStart(e.touches[0][key]),        { passive: true });
    track.addEventListener('touchend',   (e) => onEnd(e.changedTouches[0][key]),   { passive: true });
    track.addEventListener('mousedown',  (e) => { mouseDown = true; onStart(e[key]); });
    document.addEventListener('mouseup', (e) => { if (mouseDown) { mouseDown = false; onEnd(e[key]); } });
  }

  // Infinite carousel: clone first+last real cards, silent-jump when scroll settles on a clone
  function v2InitInfiniteClones(track, state, isVertical) {
    if (!track) return;
    const realCards = Array.from(track.children);
    const n = realCards.length;
    if (n <= 1) return;

    // Increment generation so stale scroll listeners self-disable on rebuild
    state.infiniteGen = (state.infiniteGen || 0) + 1;
    const gen = state.infiniteGen;

    const cloneLast  = realCards[n - 1].cloneNode(true);
    const cloneFirst = realCards[0].cloneNode(true);
    cloneLast.setAttribute('aria-hidden', 'true');
    cloneFirst.setAttribute('aria-hidden', 'true');
    track.insertBefore(cloneLast, realCards[0]);   // slot 0
    track.appendChild(cloneFirst);                  // slot n+1

    // slot size = card dimension + gap
    const getSlot = () => {
      const c = track.children[1]; // first real card is now at index 1
      if (!c) return 0;
      const g = parseFloat(getComputedStyle(track).gap || '0');
      return (isVertical ? c.offsetHeight : c.offsetWidth) + g;
    };

    // Scroll to real card 0 without animation
    requestAnimationFrame(() => {
      const slot = getSlot();
      if (isVertical) track.scrollTop  = slot;
      else            track.scrollLeft = slot;
    });

    state.infinite = { n, getSlot, isVertical };

    // After scroll settles on a clone → silently jump to the real counterpart
    let jumpTimer = null;
    track.addEventListener('scroll', () => {
      clearTimeout(jumpTimer);
      jumpTimer = setTimeout(() => {
        if (state.isAnimating || state.infiniteJumping || state.infiniteGen !== gen) return;
        const slot = getSlot(); if (!slot) return;
        const pos  = isVertical ? track.scrollTop : track.scrollLeft;
        if (pos < slot * 0.5) {
          // Landed on clone_last → jump to real card n-1
          state.infiniteJumping = true;
          if (isVertical) track.scrollTop  = n * slot;
          else            track.scrollLeft = n * slot;
          requestAnimationFrame(() => { state.infiniteJumping = false; });
          if (state.idx !== n - 1) {
            state.idx = n - 1;
            v2SnapVisuals(n-1, state.stops, state.dots, state.indicator, state.progress, buildArcPath, state.ledGlowId);
          }
        } else if (pos > (n + 0.5) * slot) {
          // Landed on clone_first → jump to real card 0
          state.infiniteJumping = true;
          if (isVertical) track.scrollTop  = slot;
          else            track.scrollLeft = slot;
          requestAnimationFrame(() => { state.infiniteJumping = false; });
          if (state.idx !== 0) {
            state.idx = 0;
            v2SnapVisuals(0, state.stops, state.dots, state.indicator, state.progress, buildArcPath, state.ledGlowId);
          }
        }
      }, 80);
    }, { passive: true });
  }

  // Scroll-driven snap (instant, guards animation + modal)
  function wireV2ScrollSnap(track, state, isVertical) {
    if (!track) return;
    let ticking = false;
    track.addEventListener('scroll', () => {
      if (ticking) return; ticking = true;
      requestAnimationFrame(() => {
        if (!isModalOpen && !state.isAnimating && !state.infiniteJumping && state.dots.length) {
          const n = state.dots.length;
          const pos = isVertical ? track.scrollTop  : track.scrollLeft;
          let newIdx;
          if (state.infinite) {
            const slot = state.infinite.getSlot();
            newIdx = slot > 0 ? Math.max(0, Math.min(n - 1, Math.round((pos - slot) / slot))) : 0;
          } else {
            const max = isVertical ? (track.scrollHeight - track.clientHeight) : (track.scrollWidth - track.clientWidth);
            newIdx = max > 0 ? Math.min(n - 1, Math.round(pos / max * (n - 1))) : 0;
          }
          if (newIdx !== state.idx) {
            state.idx = newIdx;
            v2SnapVisuals(newIdx, state.stops, state.dots, state.indicator, state.progress, buildArcPath, state.ledGlowId);
          }
        }
        ticking = false;
      });
    }, { passive: true });
  }

  // ══════════════════════════════════════════════
  //  V2 VIDEO MODAL (Vimeo)
  // ══════════════════════════════════════════════
  const v2VideoModal  = document.getElementById('v2-video-modal');
  const v2VideoIframe = document.getElementById('v2-video-iframe');
  const v2VideoClose  = document.getElementById('v2-video-close');
  const v2ModalTitle  = document.getElementById('v2-modal-title');
  const v2ModalSub    = document.getElementById('v2-modal-sub');

  function openV2VideoModal(vimeoId, title, sub) {
    if (!v2VideoModal) return;
    v2VideoIframe.src = `https://player.vimeo.com/video/${vimeoId}?autoplay=1&color=3A8A65&title=0&byline=0&portrait=0`;
    if (v2ModalTitle) v2ModalTitle.textContent = title || '';
    if (v2ModalSub)   v2ModalSub.textContent   = sub   || '';
    v2VideoModal.classList.add('open');
    v2VideoModal.setAttribute('aria-hidden', 'false');
    document.body.style.overflow = 'hidden';
    isModalOpen = true;
  }
  function closeV2VideoModal() {
    if (!v2VideoModal) return;
    v2VideoModal.classList.remove('open');
    v2VideoModal.setAttribute('aria-hidden', 'true');
    v2VideoIframe.src = '';  // stop video
    document.body.style.overflow = '';
    isModalOpen = false;
  }
  if (v2VideoClose) v2VideoClose.addEventListener('click', closeV2VideoModal);
  if (v2VideoModal) v2VideoModal.addEventListener('click', (e) => { if (e.target === v2VideoModal) closeV2VideoModal(); });
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && v2VideoModal?.classList.contains('open')) closeV2VideoModal(); });

  // ══════════════════════════════════════════════
  //  REEL V2 — centered horizontal carousel, wrap, modal on click
  // ══════════════════════════════════════════════
  (() => {
    const track    = document.getElementById('r2-track');
    const dotsGrp  = document.getElementById('r2-dots-group');   // no group — dots are in SVG directly
    const indicator = document.getElementById('r2-indicator');
    const progress  = document.getElementById('r2-progress');
    const knobBody  = document.getElementById('r2-knob-body');
    const dotEls    = Array.from(document.querySelectorAll('.r2-dot'));
    const cardEls   = Array.from(document.querySelectorAll('[data-r2-card]'));
    const btns      = Array.from(document.querySelectorAll('[data-r2-idx]'));
    if (!track || !cardEls.length) return;

    const N = cardEls.length;
    const stops = v2GetStops(N);
    const state = {
      idx: 0, isAnimating: false,
      dots: dotEls, stops, cardEls, track, indicator, progress,
      ledGlowId: 'r2-led-glow',
      active: true,
    };

    const goTo = (t) => v2GoToWrapped(t, state);

    // Dot clicks
    dotEls.forEach(d => d.addEventListener('click', () => goTo(Number(d.dataset.index))));

    // Selector button clicks
    btns.forEach(b => b.addEventListener('click', () => {
      btns.forEach(x => x.classList.remove('active'));
      b.classList.add('active');
      goTo(Number(b.dataset.r2Idx));
    }));

    // Card click → open video modal
    cardEls.forEach(card => card.addEventListener('click', () => {
      openV2VideoModal(card.dataset.vimeoId, card.dataset.title, card.dataset.sub);
    }));

    // Scroll-driven snap
    wireV2ScrollSnap(track, state, false);

    // Drag
    wireV2HorizDrag(knobBody, state, goTo, true);

    // Sync selector buttons on snap
    const origSnap = () => { btns.forEach((b, i) => b.classList.toggle('active', i === state.idx)); };
    track.addEventListener('scroll', () => requestAnimationFrame(origSnap), { passive: true });

    // Init visuals + infinite clones
    v2SnapVisuals(0, stops, dotEls, indicator, progress, buildArcPath, 'r2-led-glow');
    v2InitInfiniteClones(track, state, false);
  })();

  // ══════════════════════════════════════════════
  //  WORK V2 — centered horizontal carousel, clamped, modal on click
  // ══════════════════════════════════════════════
  (() => {
    const track     = document.getElementById('w2-track');
    const dotsGrp   = document.getElementById('w2-dots-group');
    const indicator  = document.getElementById('w2-indicator');
    const indicLine  = document.getElementById('w2-indicator-line');
    const indicDot   = document.getElementById('w2-indicator-dot');
    const inactArc   = document.getElementById('w2-inactive-arc');
    const progress   = document.getElementById('w2-progress');
    const knobBody   = document.getElementById('w2-knob-body');
    const catBtns    = Array.from(document.querySelectorAll('[data-w2-cat]'));
    const srcPanels  = Array.from(document.querySelectorAll('[data-w2-src]'));
    if (!track) return;

    let state = { idx: 0, isAnimating: false, dots: [], stops: [], cardEls: [], track, indicator, progress, ledGlowId: 'w2-led-glow', active: false };

    function buildW2Track(catIdx) {
      // Read source data elements
      const src = document.querySelector(`[data-w2-src="${catIdx}"]`);
      if (!src) return;
      const dataEls = Array.from(src.querySelectorAll('[data-w2-card]'));

      // Clear track
      track.innerHTML = '';

      // Build carousel cards
      dataEls.forEach((el, i) => {
        const d = el.dataset;
        const card = document.createElement('div');
        card.className = 'v2-card-portrait';
        card.style.cssText = `--cc:${d.cc};--ct:${d.ct};`;
        card.dataset.w2CardIdx = String(i);
        Object.assign(card.dataset, {
          title: d.title, studio: d.studio, year: d.year,
          desc: d.desc, tags: d.tags, note: d.note,
          ios: d.ios, android: d.android,
          icon: d.icon, label: d.label,
          thumbBg: d.thumbBg, thumb: d.thumb || '',
          thumbPos: d.thumbPos || 'center center',
        });
        if (d.thumbPos) card.style.setProperty('--thumb-pos', d.thumbPos);
        card.innerHTML = `
          ${d.thumb
            ? `<img class="pw2c-thumb-img" src="${d.thumb}" alt="${d.title}" loading="lazy">`
            : `<div class="pw2c-bg" style="background:${d.thumbBg};"></div><span class="pw2c-icon">${d.icon}</span>`
          }
          <div class="pw2c-top-fade"></div>
          <div class="pw2c-overlay"></div>
          <div class="pw2c-strip">
            <div class="pw2c-meta">
              <span class="pw2c-studio">${d.studio}</span>
              <span class="pw2c-year">${d.year}</span>
            </div>
            <p class="pw2c-title">${d.title}</p>
            <div class="pw2c-tags">${d.tags.split(',').map(t => `<span class="pw2c-tag">${t.trim()}</span>`).join('')}</div>
          </div>
          ${d.note ? `<span class="pw2c-note">${d.note}</span>` : ''}`;
        // Card click → expand modal (reuse existing card modal)
        card.addEventListener('click', () => openCardModal(card));
        track.appendChild(card);
      });

      // Build knob dots + update state
      const n = dataEls.length;
      const dots = buildV2Dots(dotsGrp, n, 'w2-led-glow');
      dots.forEach(d => d.addEventListener('click', () => goTo(Number(d.dataset.index))));
      const stops = v2GetStops(n);
      state.dots = dots; state.stops = stops;
      state.cardEls = Array.from(track.querySelectorAll('.v2-card-portrait'));
      state.idx = 0; state.isAnimating = false;

      const scrollable = n > 1;
      state.active = scrollable;
      if (!scrollable) {
        if (inactArc)  inactArc.style.display  = '';
        if (progress)  { progress.setAttribute('d', ''); progress.style.display = 'none'; }
        if (indicator) indicator.style.transform = 'rotate(0deg)';
        if (indicLine) indicLine.setAttribute('stroke', '#243447');
        if (indicDot)  indicDot.setAttribute('fill', '#4a5f78');
      } else {
        if (inactArc)  inactArc.style.display  = 'none';
        if (progress)  progress.style.display  = '';
        if (indicLine) indicLine.setAttribute('stroke', '#8A9BB0');
        if (indicDot)  indicDot.setAttribute('fill', '#3A8A65');
        v2SnapVisuals(0, stops, dots, indicator, progress, buildArcPath, 'w2-led-glow');
        v2InitInfiniteClones(track, state, false);
      }
    }

    const goTo = (t) => v2GoToWrapped(t, state);

    // Category buttons
    catBtns.forEach(b => b.addEventListener('click', () => {
      catBtns.forEach(x => x.classList.remove('active'));
      b.classList.add('active');
      track.scrollTo({ left: 0, behavior: 'instant' });
      buildW2Track(Number(b.dataset.w2Cat));
    }));

    // Scroll-driven snap + drag
    wireV2ScrollSnap(track, state, false);
    wireV2HorizDrag(knobBody, state, goTo, true);

    // Init with Game SD (cat 0)
    buildW2Track(0);
  })();

  // ══════════════════════════════════════════════
  //  LISTEN V2 — vertical carousel, category switching, SC playback
  // ══════════════════════════════════════════════
  (() => {
    const track    = document.getElementById('lc2-track');
    const dotsGrp  = document.getElementById('lc2-dots-group');
    const indicator = document.getElementById('lc2-indicator');
    const indicLine = document.getElementById('lc2-indicator-line');
    const indicDot  = document.getElementById('lc2-indicator-dot');
    const inactArc  = document.getElementById('lc2-inactive-arc');
    const progress  = document.getElementById('lc2-progress');
    const knobBody  = document.getElementById('lc2-knob-body');
    const catBtns   = Array.from(document.querySelectorAll('[data-lc2-cat]'));
    if (!track) return;

    let lc2Players = [], lc2Playing = -1;
    let state = { idx: 0, isAnimating: false, dots: [], stops: [], cardEls: [], track, indicator, progress, ledGlowId: 'lc2-led-glow', active: false };

    function wireLc2Playback() {
      lc2Players.forEach(p => { try { p.pause(); } catch(e) {} });
      lc2Players = []; lc2Playing = -1;
      if (typeof SC === 'undefined') return;
      const iframes  = Array.from(track.querySelectorAll('.v2lc-sc-iframe'));
      const playBtns = Array.from(track.querySelectorAll('[data-lc2-play]'));
      const progBars = Array.from(track.querySelectorAll('[data-lc2-bar]'));
      iframes.forEach((iframe, i) => {
        const widget = SC.Widget(iframe);
        lc2Players[i] = widget;
        widget.bind(SC.Widget.Events.PLAY, () => { lc2Playing = i; playBtns.forEach((b,j) => b.classList.toggle('playing', j===i)); });
        widget.bind(SC.Widget.Events.PAUSE,  () => { if (lc2Playing===i) { playBtns[i]?.classList.remove('playing'); lc2Playing=-1; } });
        widget.bind(SC.Widget.Events.FINISH, () => { playBtns[i]?.classList.remove('playing'); lc2Playing=-1; });
        widget.bind(SC.Widget.Events.PLAY_PROGRESS, (e) => {
          const bar = progBars[i]; if (!bar) return;
          bar.querySelector('.v2lc-progress-fill')?.style.setProperty('width', `${(e.relativePosition||0)*100}%`);
          const fmt = s => { const m=Math.floor(s/60); return `${m}:${String(Math.floor(s%60)).padStart(2,'0')}`; };
          const card = bar.closest('.v2-card-v2');
          if (card?.querySelector('.v2lc-time-cur')) card.querySelector('.v2lc-time-cur').textContent = fmt(e.currentPosition/1000);
          widget.getDuration(d => { if (card?.querySelector('.v2lc-time-dur')) card.querySelector('.v2lc-time-dur').textContent = fmt(d/1000); });
        });
        playBtns[i]?.addEventListener('click', ev => {
          ev.stopPropagation();
          if (lc2Playing===i) { widget.pause(); }
          else { lc2Players.forEach((p,j) => { if(j!==i){p.pause(); playBtns[j]?.classList.remove('playing');} }); widget.play(); }
        });
        progBars[i]?.addEventListener('click', ev => {
          const pct = (ev.clientX - progBars[i].getBoundingClientRect().left) / progBars[i].offsetWidth;
          widget.getDuration(d => widget.seekTo(pct*d));
        });
      });
    }

    function buildLc2Track(catIdx) {
      const src = document.querySelector(`[data-lc2-src="${catIdx}"]`);
      if (!src) return;
      const dataEls = Array.from(src.querySelectorAll('[data-lc2-card]'));
      track.innerHTML = '';
      dataEls.forEach((el, i) => {
        const d = el.dataset;
        const card = document.createElement('div');
        card.className = 'v2-card-v2';
        card.style.cssText = `--cc:${d.color};`;
        card.dataset.lc2Idx = String(i);
        card.dataset.url = d.url;
        card.innerHTML = `
          <div class="v2lc-thumb">
            <div class="v2lc-thumb-bg" style="background:${d.thumbBg};"></div>
            ${d.thumb ? `<img class="v2lc-thumb-img" src="${d.thumb}" alt="${d.title}" loading="lazy">` : ''}
            <span class="v2lc-thumb-icon">${d.icon}</span>
          </div>
          <div class="v2lc-body">
            <div class="v2lc-accent"></div>
            <div class="v2lc-header">
              <span class="v2lc-label">${d.label}</span>
              <span class="v2lc-year">${d.year}</span>
            </div>
            <div class="v2lc-main">
              <button class="v2lc-play-btn" data-lc2-play="${i}" aria-label="Play ${d.title}">
                <svg class="lc-icon-play" viewBox="0 0 16 18" fill="currentColor"><path d="M0 0L16 9L0 18V0Z"/></svg>
                <svg class="lc-icon-pause" viewBox="0 0 14 16" fill="currentColor"><rect x="0" y="0" width="4" height="16"/><rect x="9" y="0" width="4" height="16"/></svg>
              </button>
              <div class="v2lc-right">
                <p class="v2lc-title">${d.title}</p>
                <div class="v2lc-progress-wrap">
                  <div class="v2lc-progress-bar" data-lc2-bar="${i}"><div class="v2lc-progress-fill"></div></div>
                  <div class="v2lc-time-row"><span class="v2lc-time-cur">0:00</span><span class="v2lc-time-dur">—:——</span></div>
                </div>
              </div>
            </div>
            <div class="v2lc-tags">${d.tags.split(',').map(t=>`<span class="v2lc-tag">${t.trim()}</span>`).join('')}</div>
          </div>
          <iframe class="v2lc-sc-iframe" scrolling="no" frameborder="no" allow="autoplay"
            src="https://w.soundcloud.com/player/?url=${encodeURIComponent(d.url)}&auto_play=false&hide_related=true&show_comments=false&show_user=false&show_reposts=false&show_teaser=false"></iframe>`;
        track.appendChild(card);
      });

      const n = dataEls.length;
      const dots = buildV2Dots(dotsGrp, n, 'lc2-led-glow');
      dots.forEach(d => d.addEventListener('click', () => lc2GoTo(Number(d.dataset.index))));
      const stops = v2GetStops(n);
      state.dots = dots; state.stops = stops;
      state.cardEls = Array.from(track.querySelectorAll('.v2-card-v2'));
      state.idx = 0; state.isAnimating = false;
      const scrollable = n > 1;
      state.active = scrollable;
      if (!scrollable) {
        if (inactArc)  inactArc.style.display = '';
        if (progress)  { progress.setAttribute('d',''); progress.style.display='none'; }
        if (indicator) indicator.style.transform = 'rotate(0deg)';
        if (indicLine) indicLine.setAttribute('stroke','#243447');
        if (indicDot)  indicDot.setAttribute('fill','#4a5f78');
      } else {
        if (inactArc)  inactArc.style.display = 'none';
        if (progress)  progress.style.display = '';
        if (indicLine) indicLine.setAttribute('stroke','#8A9BB0');
        if (indicDot)  indicDot.setAttribute('fill','#3A8A65');
        v2SnapVisuals(0, stops, dots, indicator, progress, buildArcPath, 'lc2-led-glow');
        v2InitInfiniteClones(track, state, true);
      }
      requestAnimationFrame(() => wireLc2Playback());
    }

    const lc2GoTo = t => v2GoToWrapped(t, state);
    catBtns.forEach(b => b.addEventListener('click', () => {
      catBtns.forEach(x => x.classList.remove('active'));
      b.classList.add('active');
      track.scrollTo({ top: 0, behavior: 'instant' });
      buildLc2Track(Number(b.dataset.lc2Cat));
    }));
    wireV2HorizDrag(knobBody, state, lc2GoTo, true);
    wireV2ScrollSnap(track, state, true);
    buildLc2Track(0);
  })();

  // ══════════════════════════════════════════════
  //  LISTEN V3 — horizontal carousel, category switching, SC playback
  // ══════════════════════════════════════════════
  (() => {
    const track    = document.getElementById('lc3-track');
    const dotsGrp  = document.getElementById('lc3-dots-group');
    const indicator = document.getElementById('lc3-indicator');
    const indicLine = document.getElementById('lc3-indicator-line');
    const indicDot  = document.getElementById('lc3-indicator-dot');
    const inactArc  = document.getElementById('lc3-inactive-arc');
    const progress  = document.getElementById('lc3-progress');
    const knobBody  = document.getElementById('lc3-knob-body');
    const catBtns   = Array.from(document.querySelectorAll('[data-lc3-cat]'));
    if (!track) return;

    let lc3Players = [], lc3Playing = -1;
    let state = { idx: 0, isAnimating: false, dots: [], stops: [], cardEls: [], track, indicator, progress, ledGlowId: 'lc3-led-glow', active: false };

    const lc3H2 = document.querySelector('#listen-v3 .section-h2');
    const lc3H2Base = lc3H2 ? lc3H2.textContent.trim() : 'Listen';
    let lc3H2Timer = null;

    function setLc3H2Playing(title) {
      if (!lc3H2) return;
      if (lc3H2Timer) { clearTimeout(lc3H2Timer); lc3H2Timer = null; }
      // "Listen" stays — only "ing to [title]" animates in L→R
      const suffix = `ing to ${title}`;
      const titleStart = 'ing to '.length;
      lc3H2.innerHTML = 'Listen' + suffix.split('').map((ch, i) => {
        const cls   = i >= titleStart ? 'lc3-title-letter' : 'lc3-letter';
        const delay = (i * 0.03).toFixed(2);
        return `<span class="${cls}" style="animation-delay:${delay}s">${ch === ' ' ? '&nbsp;' : ch}</span>`;
      }).join('');
    }

    function resetLc3H2() {
      if (!lc3H2) return;
      const letters = Array.from(lc3H2.querySelectorAll('.lc3-letter, .lc3-title-letter'));
      if (!letters.length) { lc3H2.textContent = lc3H2Base; return; }
      const n = letters.length;
      // Animate out R→L: rightmost letter leaves first
      letters.forEach((el, i) => {
        el.style.animation = `lc3-letter-out 0.18s ease ${((n - 1 - i) * 0.018).toFixed(2)}s forwards`;
      });
      if (lc3H2Timer) clearTimeout(lc3H2Timer);
      lc3H2Timer = setTimeout(() => { lc3H2.textContent = lc3H2Base; lc3H2Timer = null; }, n * 18 + 200);
    }

    function wireLc3Playback() {
      lc3Players.forEach(p => { try { p.pause(); } catch(e) {} });
      lc3Players = []; lc3Playing = -1;
      resetLc3H2();
      if (typeof SC === 'undefined') return;
      const iframes  = Array.from(track.querySelectorAll('.v3lc-sc-iframe'));
      const playBtns = Array.from(track.querySelectorAll('[data-lc3-play]'));
      const progBars = Array.from(track.querySelectorAll('[data-lc3-bar]'));
      iframes.forEach((iframe, i) => {
        const widget = SC.Widget(iframe);
        lc3Players[i] = widget;
        widget.bind(SC.Widget.Events.PLAY, () => {
          lc3Playing = i;
          playBtns.forEach((b,j) => b.classList.toggle('playing', j===i));
          const title = iframe.closest('.v2-card-portrait')?.querySelector('.v3lc-title')?.textContent || '';
          setLc3H2Playing(title);
        });
        widget.bind(SC.Widget.Events.PAUSE,  () => { if (lc3Playing===i) { playBtns[i]?.classList.remove('playing'); lc3Playing=-1; resetLc3H2(); } });
        widget.bind(SC.Widget.Events.FINISH, () => { playBtns[i]?.classList.remove('playing'); lc3Playing=-1; resetLc3H2(); });
        widget.bind(SC.Widget.Events.PLAY_PROGRESS, (e) => {
          const bar = progBars[i]; if (!bar) return;
          bar.querySelector('.v3lc-progress-fill')?.style.setProperty('width', `${(e.relativePosition||0)*100}%`);
          const fmt = s => { const m=Math.floor(s/60); return `${m}:${String(Math.floor(s%60)).padStart(2,'0')}`; };
          const card = bar.closest('.v2-card-portrait');
          if (card?.querySelector('.v3lc-time-cur')) card.querySelector('.v3lc-time-cur').textContent = fmt(e.currentPosition/1000);
          widget.getDuration(d => { if (card?.querySelector('.v3lc-time-dur')) card.querySelector('.v3lc-time-dur').textContent = fmt(d/1000); });
        });
        playBtns[i]?.addEventListener('click', ev => {
          ev.stopPropagation();
          if (lc3Playing===i) { widget.pause(); }
          else { lc3Players.forEach((p,j) => { if(j!==i){p.pause(); playBtns[j]?.classList.remove('playing');} }); widget.play(); }
        });
        progBars[i]?.addEventListener('click', ev => {
          const pct = (ev.clientX - progBars[i].getBoundingClientRect().left) / progBars[i].offsetWidth;
          widget.getDuration(d => widget.seekTo(pct*d));
        });
      });
    }

    function buildLc3Track(catIdx) {
      const src = document.querySelector(`[data-lc3-src="${catIdx}"]`);
      if (!src) return;
      const dataEls = Array.from(src.querySelectorAll('[data-lc3-card]'));
      track.innerHTML = '';
      dataEls.forEach((el, i) => {
        const d = el.dataset;
        const card = document.createElement('div');
        card.className = 'v2-card-portrait';
        card.style.cssText = `--cc:${d.color};`;
        card.dataset.lc3Idx = String(i);
        card.dataset.url = d.url;
        card.innerHTML = `
          <div class="v3lc-inner">
            <div class="v3lc-thumb">
              <div class="v3lc-thumb-bg" style="background:${d.thumbBg};"></div>
              ${d.thumb ? `<img class="v3lc-thumb-img" src="${d.thumb}" alt="${d.title}" loading="lazy">` : `<span class="v3lc-thumb-icon">${d.icon}</span>`}
              <div class="v3lc-thumb-fade"></div>
              <div class="v3lc-play-overlay">
                <button class="v3lc-play-btn" data-lc3-play="${i}" aria-label="Play ${d.title}">
                  <svg class="lc-icon-play" viewBox="0 0 16 18"><path d="M0 0L16 9L0 18V0Z"/></svg>
                  <svg class="lc-icon-pause" viewBox="0 0 14 16"><rect x="0" y="0" width="4" height="16"/><rect x="9" y="0" width="4" height="16"/></svg>
                </button>
              </div>
              <div class="v3lc-thumb-accent"></div>
            </div>
            <div class="v3lc-strip">
              <div class="v3lc-header">
                <span class="v3lc-label">${d.label}</span>
                <span class="v3lc-year">${d.year}</span>
              </div>
              <p class="v3lc-title">${d.title}</p>
              <p class="v3lc-desc">${d.desc}</p>
              <div class="v3lc-progress-wrap">
                <div class="v3lc-progress-bar" data-lc3-bar="${i}"><div class="v3lc-progress-fill"></div></div>
                <div class="v3lc-time-row"><span class="v3lc-time-cur">0:00</span><span class="v3lc-time-dur">—:——</span></div>
              </div>
              <div class="v3lc-tags">${d.tags.split(',').map(t=>`<span class="v3lc-tag">${t.trim()}</span>`).join('')}</div>
            </div>
          </div>
          <iframe class="v3lc-sc-iframe" scrolling="no" frameborder="no" allow="autoplay"
            src="https://w.soundcloud.com/player/?url=${encodeURIComponent(d.url)}&auto_play=false&hide_related=true&show_comments=false&show_user=false&show_reposts=false&show_teaser=false"></iframe>`;
        track.appendChild(card);
      });

      const n = dataEls.length;
      const dots = buildV2Dots(dotsGrp, n, 'lc3-led-glow');
      dots.forEach(d => d.addEventListener('click', () => lc3GoTo(Number(d.dataset.index))));
      const stops = v2GetStops(n);
      state.dots = dots; state.stops = stops;
      state.cardEls = Array.from(track.querySelectorAll('.v2-card-portrait'));
      state.idx = 0; state.isAnimating = false;
      const scrollable = n > 1;
      state.active = scrollable;
      if (!scrollable) {
        if (inactArc)  inactArc.style.display = '';
        if (progress)  { progress.setAttribute('d',''); progress.style.display='none'; }
        if (indicator) indicator.style.transform = 'rotate(0deg)';
        if (indicLine) indicLine.setAttribute('stroke','#243447');
        if (indicDot)  indicDot.setAttribute('fill','#4a5f78');
      } else {
        if (inactArc)  inactArc.style.display = 'none';
        if (progress)  progress.style.display = '';
        if (indicLine) indicLine.setAttribute('stroke','#8A9BB0');
        if (indicDot)  indicDot.setAttribute('fill','#3A8A65');
        v2SnapVisuals(0, stops, dots, indicator, progress, buildArcPath, 'lc3-led-glow');
        v2InitInfiniteClones(track, state, false);
      }
      requestAnimationFrame(() => wireLc3Playback());
    }

    const lc3GoTo = t => v2GoToWrapped(t, state);
    catBtns.forEach(b => b.addEventListener('click', () => {
      catBtns.forEach(x => x.classList.remove('active'));
      b.classList.add('active');
      track.scrollTo({ left: 0, behavior: 'instant' });
      buildLc3Track(Number(b.dataset.lc3Cat));
    }));
    wireV2HorizDrag(knobBody, state, lc3GoTo, true);
    wireV2ScrollSnap(track, state, false);
    buildLc3Track(0);
  })();

  // ══════════════════════════════════════════════════════════════════
  // ── AUDIO ENGINE ──────────────────────────────────────────────────
  // All sounds synthesized via Web Audio API. No sample files needed.
  // Gated by soundOn. AudioContext created on first user interaction.
  // ══════════════════════════════════════════════════════════════════
  let _ctx = null;
  let _masterGain = null;

  function _getCtx() {
    if (!_ctx) {
      _ctx = new (window.AudioContext || window.webkitAudioContext)();
      _masterGain = _ctx.createGain();
      _masterGain.gain.value = 0.55;
      _masterGain.connect(_ctx.destination);
    }
    if (_ctx.state === 'suspended') _ctx.resume();
    return _ctx;
  }

  // Pan -1 (left) → +1 (right) based on element's center X in viewport
  function _getPan(el) {
    if (!el) return 0;
    const r = el.getBoundingClientRect();
    return Math.max(-1, Math.min(1, ((r.left + r.width / 2) / window.innerWidth) * 2 - 1));
  }

  // Route: source → panner → masterGain
  function _route(source, pan) {
    const panner = _ctx.createStereoPanner();
    panner.pan.value = pan;
    source.connect(panner);
    panner.connect(_masterGain);
    return panner;
  }

  // ── SOUND RECIPES ──────────────────────────────────────────────────

  // UI click — short sine blip, slightly detuned per call
  function _sfxClick(pan) {
    const ctx = _getCtx();
    const osc = ctx.createOscillator();
    const g = ctx.createGain();
    osc.type = 'sine';
    osc.frequency.value = 880 + (Math.random() * 80 - 40);
    g.gain.setValueAtTime(0.28, ctx.currentTime);
    g.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + 0.12);
    osc.connect(g);
    const panner = ctx.createStereoPanner(); panner.pan.value = pan;
    g.connect(panner); panner.connect(_masterGain);
    osc.start(); osc.stop(ctx.currentTime + 0.13);
  }

  // Knob turn — short filtered click with pitch based on direction
  function _sfxKnob(pan, dirUp = true) {
    const ctx = _getCtx();
    const osc = ctx.createOscillator();
    const g = ctx.createGain();
    osc.type = 'triangle';
    osc.frequency.value = dirUp ? 660 : 440;
    osc.frequency.exponentialRampToValueAtTime(dirUp ? 880 : 330, ctx.currentTime + 0.07);
    g.gain.setValueAtTime(0.22, ctx.currentTime);
    g.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + 0.1);
    osc.connect(g);
    const panner = ctx.createStereoPanner(); panner.pan.value = pan;
    g.connect(panner); panner.connect(_masterGain);
    osc.start(); osc.stop(ctx.currentTime + 0.11);
  }

  // Modal open — soft upward sweep
  function _sfxModalOpen(pan) {
    const ctx = _getCtx();
    const osc = ctx.createOscillator();
    const g = ctx.createGain();
    osc.type = 'sine';
    osc.frequency.setValueAtTime(440, ctx.currentTime);
    osc.frequency.exponentialRampToValueAtTime(880, ctx.currentTime + 0.18);
    g.gain.setValueAtTime(0.18, ctx.currentTime);
    g.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + 0.22);
    osc.connect(g);
    const panner = ctx.createStereoPanner(); panner.pan.value = pan;
    g.connect(panner); panner.connect(_masterGain);
    osc.start(); osc.stop(ctx.currentTime + 0.23);
  }

  // Modal close — soft downward sweep
  function _sfxModalClose(pan) {
    const ctx = _getCtx();
    const osc = ctx.createOscillator();
    const g = ctx.createGain();
    osc.type = 'sine';
    osc.frequency.setValueAtTime(660, ctx.currentTime);
    osc.frequency.exponentialRampToValueAtTime(330, ctx.currentTime + 0.16);
    g.gain.setValueAtTime(0.14, ctx.currentTime);
    g.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + 0.18);
    osc.connect(g);
    const panner = ctx.createStereoPanner(); panner.pan.value = pan;
    g.connect(panner); panner.connect(_masterGain);
    osc.start(); osc.stop(ctx.currentTime + 0.19);
  }

  // Scroll whoosh — white noise burst through bandpass, gain envelope
  function _sfxWhoosh(dirDown = true) {
    const ctx = _getCtx();
    const bufLen = ctx.sampleRate * 0.18;
    const buf = ctx.createBuffer(1, bufLen, ctx.sampleRate);
    const data = buf.getChannelData(0);
    for (let i = 0; i < bufLen; i++) data[i] = Math.random() * 2 - 1;
    const src = ctx.createBufferSource();
    src.buffer = buf;
    const bp = ctx.createBiquadFilter();
    bp.type = 'bandpass';
    bp.frequency.setValueAtTime(dirDown ? 2400 : 1200, ctx.currentTime);
    bp.frequency.exponentialRampToValueAtTime(dirDown ? 600 : 2800, ctx.currentTime + 0.15);
    bp.Q.value = 1.4;
    const g = ctx.createGain();
    g.gain.setValueAtTime(0.001, ctx.currentTime);
    g.gain.linearRampToValueAtTime(0.32, ctx.currentTime + 0.04);
    g.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + 0.18);
    src.connect(bp); bp.connect(g); g.connect(_masterGain);
    src.start(); src.stop(ctx.currentTime + 0.19);
  }

  // ── GLYPH SOUNDS (one per type) ────────────────────────────────────

  // 8th/16th note — plucked string tone
  function _sfxNote(pan, is16th = false) {
    const ctx = _getCtx();
    const freq = is16th ? 1047 : 784; // C6 or G5
    const osc = ctx.createOscillator();
    const g = ctx.createGain();
    osc.type = 'triangle';
    osc.frequency.value = freq;
    g.gain.setValueAtTime(0.3, ctx.currentTime);
    g.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + 0.55);
    osc.connect(g);
    const panner = ctx.createStereoPanner(); panner.pan.value = pan;
    g.connect(panner); panner.connect(_masterGain);
    osc.start(); osc.stop(ctx.currentTime + 0.56);
  }

  // Piano — short stacked chord (3 detuned sines)
  function _sfxPiano(pan) {
    const ctx = _getCtx();
    const freqs = [261.6, 329.6, 392]; // C4 E4 G4 — major triad
    freqs.forEach((f, i) => {
      const osc = ctx.createOscillator();
      const g = ctx.createGain();
      osc.type = 'sine';
      osc.frequency.value = f;
      const delay = i * 0.07;
      g.gain.setValueAtTime(0, ctx.currentTime);
      g.gain.linearRampToValueAtTime(0.22, ctx.currentTime + delay + 0.01);
      g.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + delay + 0.6);
      osc.connect(g);
      const panner = ctx.createStereoPanner(); panner.pan.value = pan;
      g.connect(panner); panner.connect(_masterGain);
      osc.start(ctx.currentTime + delay);
      osc.stop(ctx.currentTime + delay + 0.65);
    });
  }

  // Harp — ascending glissando (5 notes)
  function _sfxHarp(pan) {
    const ctx = _getCtx();
    const freqs = [392, 494, 587, 698, 784]; // G4 B4 D5 F5 G5
    freqs.forEach((f, i) => {
      const osc = ctx.createOscillator();
      const g = ctx.createGain();
      osc.type = 'triangle';
      osc.frequency.value = f;
      const t = ctx.currentTime + i * 0.06;
      g.gain.setValueAtTime(0.22, t);
      g.gain.exponentialRampToValueAtTime(0.001, t + 0.4);
      osc.connect(g);
      const panner = ctx.createStereoPanner(); panner.pan.value = pan;
      g.connect(panner); panner.connect(_masterGain);
      osc.start(t); osc.stop(t + 0.42);
    });
  }

  // Waveform — rising sci-fi sweep
  function _sfxWaveform(pan) {
    const ctx = _getCtx();
    const osc = ctx.createOscillator();
    const g = ctx.createGain();
    osc.type = 'sawtooth';
    osc.frequency.setValueAtTime(200, ctx.currentTime);
    osc.frequency.exponentialRampToValueAtTime(1600, ctx.currentTime + 0.45);
    const lp = ctx.createBiquadFilter();
    lp.type = 'lowpass'; lp.frequency.value = 1800;
    g.gain.setValueAtTime(0.18, ctx.currentTime);
    g.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + 0.48);
    osc.connect(lp); lp.connect(g);
    const panner = ctx.createStereoPanner(); panner.pan.value = pan;
    g.connect(panner); panner.connect(_masterGain);
    osc.start(); osc.stop(ctx.currentTime + 0.5);
  }

  // Headphones — two-tone stereo pulse (simulates bass thump)
  function _sfxHeadphones(pan) {
    const ctx = _getCtx();
    [0, 0.33].forEach(delay => {
      const osc = ctx.createOscillator();
      const g = ctx.createGain();
      osc.type = 'sine';
      osc.frequency.value = 80;
      const t = ctx.currentTime + delay;
      g.gain.setValueAtTime(0.4, t);
      g.gain.exponentialRampToValueAtTime(0.001, t + 0.18);
      osc.connect(g);
      const panner = ctx.createStereoPanner(); panner.pan.value = pan + (delay > 0 ? 0.15 : -0.15);
      g.connect(panner); panner.connect(_masterGain);
      osc.start(t); osc.stop(t + 0.2);
    });
  }

  // Papers — filtered noise flutter
  function _sfxPaper(pan) {
    const ctx = _getCtx();
    const bufLen = ctx.sampleRate * 0.22;
    const buf = ctx.createBuffer(1, bufLen, ctx.sampleRate);
    const data = buf.getChannelData(0);
    for (let i = 0; i < bufLen; i++) data[i] = Math.random() * 2 - 1;
    const src = ctx.createBufferSource();
    src.buffer = buf;
    const hp = ctx.createBiquadFilter();
    hp.type = 'highpass'; hp.frequency.value = 3000;
    const g = ctx.createGain();
    g.gain.setValueAtTime(0.001, ctx.currentTime);
    g.gain.linearRampToValueAtTime(0.25, ctx.currentTime + 0.03);
    g.gain.linearRampToValueAtTime(0.12, ctx.currentTime + 0.1);
    g.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + 0.22);
    src.connect(hp); hp.connect(g);
    const panner = ctx.createStereoPanner(); panner.pan.value = pan;
    g.connect(panner); panner.connect(_masterGain);
    src.start(); src.stop(ctx.currentTime + 0.23);
  }

  // Reel — tape machine mechanical click + brief hiss
  function _sfxReel(pan) {
    const ctx = _getCtx();
    // Click
    const osc = ctx.createOscillator();
    const g1 = ctx.createGain();
    osc.type = 'square'; osc.frequency.value = 120;
    g1.gain.setValueAtTime(0.3, ctx.currentTime);
    g1.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + 0.06);
    osc.connect(g1);
    const p1 = ctx.createStereoPanner(); p1.pan.value = pan;
    g1.connect(p1); p1.connect(_masterGain);
    osc.start(); osc.stop(ctx.currentTime + 0.07);
    // Hiss
    const bufLen = ctx.sampleRate * 0.3;
    const buf = ctx.createBuffer(1, bufLen, ctx.sampleRate);
    const d = buf.getChannelData(0);
    for (let i = 0; i < bufLen; i++) d[i] = Math.random() * 2 - 1;
    const src = ctx.createBufferSource(); src.buffer = buf;
    const bp = ctx.createBiquadFilter(); bp.type = 'bandpass'; bp.frequency.value = 6000; bp.Q.value = 0.7;
    const g2 = ctx.createGain();
    g2.gain.setValueAtTime(0.1, ctx.currentTime + 0.04);
    g2.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + 0.3);
    src.connect(bp); bp.connect(g2);
    const p2 = ctx.createStereoPanner(); p2.pan.value = pan;
    g2.connect(p2); p2.connect(_masterGain);
    src.start(ctx.currentTime + 0.04); src.stop(ctx.currentTime + 0.31);
  }

  // Tuning fork — pure sine ring-out
  function _sfxTuningFork(pan) {
    const ctx = _getCtx();
    const osc = ctx.createOscillator();
    const g = ctx.createGain();
    osc.type = 'sine'; osc.frequency.value = 440;
    g.gain.setValueAtTime(0.35, ctx.currentTime);
    g.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + 1.2);
    osc.connect(g);
    const panner = ctx.createStereoPanner(); panner.pan.value = pan;
    g.connect(panner); panner.connect(_masterGain);
    osc.start(); osc.stop(ctx.currentTime + 1.25);
  }

  // Metronome — two accented clicks
  function _sfxMetronome(pan) {
    const ctx = _getCtx();
    [0, 0.43].forEach((delay, i) => {
      const osc = ctx.createOscillator();
      const g = ctx.createGain();
      osc.type = 'triangle';
      osc.frequency.value = i === 0 ? 1200 : 900;
      const t = ctx.currentTime + delay;
      g.gain.setValueAtTime(i === 0 ? 0.38 : 0.28, t);
      g.gain.exponentialRampToValueAtTime(0.001, t + 0.07);
      osc.connect(g);
      const panner = ctx.createStereoPanner(); panner.pan.value = pan;
      g.connect(panner); panner.connect(_masterGain);
      osc.start(t); osc.stop(t + 0.08);
    });
  }

  // Speaker — low thump
  function _sfxSpeaker(pan) {
    const ctx = _getCtx();
    const osc = ctx.createOscillator();
    const g = ctx.createGain();
    osc.type = 'sine'; osc.frequency.value = 60;
    osc.frequency.exponentialRampToValueAtTime(30, ctx.currentTime + 0.12);
    g.gain.setValueAtTime(0.45, ctx.currentTime);
    g.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + 0.18);
    osc.connect(g);
    const panner = ctx.createStereoPanner(); panner.pan.value = pan;
    g.connect(panner); panner.connect(_masterGain);
    osc.start(); osc.stop(ctx.currentTime + 0.19);
  }

  // ── PUBLIC DISPATCH ────────────────────────────────────────────────
  function playSound(type, el) {
    if (!soundOn) return;
    _getCtx();
    const pan = _getPan(el);
    switch (type) {
      case 'click':      _sfxClick(pan);     break;
      case 'knob-up':    _sfxKnob(pan, true); break;
      case 'knob-down':  _sfxKnob(pan, false); break;
      case 'modal-open': _sfxModalOpen(pan); break;
      case 'modal-close':_sfxModalClose(pan); break;
      case 'whoosh-down':_sfxWhoosh(true);   break;
      case 'whoosh-up':  _sfxWhoosh(false);  break;
      case 'note8':      _sfxNote(pan, false); break;
      case 'note16':     _sfxNote(pan, true);  break;
      case 'piano':      _sfxPiano(pan);     break;
      case 'harp':       _sfxHarp(pan);      break;
      case 'waveform':   _sfxWaveform(pan);  break;
      case 'headphones': _sfxHeadphones(pan); break;
      case 'paper':      _sfxPaper(pan);     break;
      case 'reel':       _sfxReel(pan);      break;
      case 'tuningfork': _sfxTuningFork(pan); break;
      case 'metronome':  _sfxMetronome(pan); break;
      case 'speaker':    _sfxSpeaker(pan);   break;
    }
  }

  // ── HOOK: NAV BUTTONS ──────────────────────────────────────────────
  document.querySelectorAll('.nav-link, .btn-primary, .btn-ghost').forEach(btn => {
    btn.addEventListener('click', () => playSound('click', btn));
  });

  // ── HOOK: CATEGORY / REEL SELECTOR BUTTONS ────────────────────────
  document.querySelectorAll('.reel-btn, .work-btn, .listen-tab, .lc-tab, .lc2-tab, .lc3-tab').forEach(btn => {
    btn.addEventListener('click', () => playSound('click', btn));
  });

  // ── HOOK: MODAL OPEN / CLOSE ──────────────────────────────────────
  // Patch openCardModal and closeCardModal to fire sounds
  const _origOpenCard = window.openCardModal;
  const _cardModalEl = document.getElementById('card-modal');
  if (_cardModalEl) {
    const cardModalObserver = new MutationObserver((muts) => {
      muts.forEach(m => {
        if (m.attributeName === 'class') {
          if (_cardModalEl.classList.contains('open')) {
            playSound('modal-open', _cardModalEl);
          } else {
            playSound('modal-close', _cardModalEl);
          }
        }
      });
    });
    cardModalObserver.observe(_cardModalEl, { attributes: true });
  }
  const _v2VideoModalEl = document.getElementById('v2-video-modal');
  if (_v2VideoModalEl) {
    const videoModalObserver = new MutationObserver((muts) => {
      muts.forEach(m => {
        if (m.attributeName === 'class') {
          if (_v2VideoModalEl.classList.contains('open')) {
            playSound('modal-open', _v2VideoModalEl);
          } else {
            playSound('modal-close', _v2VideoModalEl);
          }
        }
      });
    });
    videoModalObserver.observe(_v2VideoModalEl, { attributes: true });
  }

  // ── HOOK: SCROLL WHOOSH ───────────────────────────────────────────
  // Fires on scroll-snap section changes (detects which direction)
  let _lastScrollTop = 0;
  let _whooshCooldown = false;
  const _scrollRoot = document.documentElement;
  _scrollRoot.addEventListener('scroll', () => {
    if (_whooshCooldown || !soundOn) return;
    const st = _scrollRoot.scrollTop;
    const dir = st > _lastScrollTop ? 'whoosh-down' : 'whoosh-up';
    _lastScrollTop = st;
    playSound(dir, null);
    _whooshCooldown = true;
    setTimeout(() => { _whooshCooldown = false; }, 600);
  }, { passive: true });

  // ── HOOK: GLYPH HOVER ─────────────────────────────────────────────
  const _glyphSoundMap = {
    'g-quarter': 'note8',   // single quarter note → short pluck
    'g-beam':    'note16',  // beamed pair → double-hit
  };
  document.querySelectorAll('.glyph').forEach(g => {
    const typeClass = [...g.classList].find(c => _glyphSoundMap[c]);
    if (!typeClass) return;
    const soundType = _glyphSoundMap[typeClass];
    // Cooldown per glyph so rapid re-hover doesn't spam
    let _glyphCooldown = false;
    g.addEventListener('mouseenter', () => {
      if (_glyphCooldown) return;
      playSound(soundType, g);
      _glyphCooldown = true;
      setTimeout(() => { _glyphCooldown = false; }, 400);
    });
  });

  // ── HOOK: SOUND TOGGLE ITSELF ─────────────────────────────────────
  // Patch: when turning ON, play a confirmation tone
  const _soundToggleBtn = document.getElementById('sound-toggle');
  if (_soundToggleBtn) {
    const _origToggleHandler = _soundToggleBtn.onclick;
    _soundToggleBtn.addEventListener('click', () => {
      // soundOn is flipped by the existing handler first (declared earlier)
      // We read it after a microtask
      setTimeout(() => {
        if (soundOn) {
          _getCtx();
          _sfxModalOpen(0); // soft confirmation sweep when enabling
        }
      }, 0);
    });
  }

  // ── END AUDIO ENGINE ──────────────────────────────────────────────

</script>

