  // -- Year odometer --
  // "20" is static. Only last 2 digits (tens + units of 20XX) animate.
  // Only changed digits animate. If tens changes but units doesn't → units does full 10-step revolution.
  // 5 reps of 0-9 per column. Anchor rep 2 (offset 20).
  // Newer year = 'up' (digits count up). Older year = 'down' (digits count down).
  const rmYearDigitCols = [];
  const rmYearVirtualY  = [-20, -20];
  const rmYearResetIds  = [null, null];
