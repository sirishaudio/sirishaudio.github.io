  });

  // ── REEL KNOB + CAROUSEL ──
  const STOP_ANGLES = [300, 330, 360, 390, 420]; // cumulative CW, 30° per step
  const ARC_START = 300;
  let currentReel = 0;
  let isAnimating = false;

  const knobIndicator = document.getElementById('knob-indicator');
  const progressArc = document.getElementById('knob-progress');
  const reelTrack = document.getElementById('reel-track');
  const knobDots = document.querySelectorAll('.knob-dot');
  const reelBtns = document.querySelectorAll('.reel-btn');

  // center (80,72) for 160x110 viewBox
  function p2xy(r, deg) {
    const rad = (deg - 90) * Math.PI / 180;
    return { x: 80 + r * Math.cos(rad), y: 72 + r * Math.sin(rad) };
  }

  function buildArcPath(startDeg, sweepDeg) {
    if (sweepDeg <= 0.5) return '';
    const s = p2xy(42, startDeg);
    const endDeg = startDeg + sweepDeg;
    const e = p2xy(42, endDeg % 360);
    const large = sweepDeg > 180 ? 1 : 0;
    return `M ${s.x.toFixed(2)} ${s.y.toFixed(2)} A 42 42 0 ${large} 1 ${e.x.toFixed(2)} ${e.y.toFixed(2)}`;
  }

  function updateKnobVisuals(idx) {
    const cumAngle = STOP_ANGLES[idx];
    if (knobIndicator) knobIndicator.style.transform = `rotate(${cumAngle}deg)`;
    if (progressArc) progressArc.setAttribute('d', idx === 0 ? '' : buildArcPath(ARC_START, cumAngle - ARC_START));
    knobDots.forEach((d, i) => {
      if (i === idx) {
        d.setAttribute('fill', '#3A8A65');
        d.setAttribute('stroke', '#2D6A4F');
        d.setAttribute('filter', 'url(#led-glow)');
      } else {
        d.setAttribute('fill', '#243D55');
        d.setAttribute('stroke', '#243447');
        d.removeAttribute('filter');
      }
    });
    reelBtns.forEach((b, i) => b.classList.toggle('active', i === idx));
  }

  const TOTAL = 5;         // real slide count
  const CAROUSEL_MS = 350; // matches CSS transition: transform 0.35s

  function sleep(ms) { return new Promise(r => setTimeout(r, ms)); }

  async function goToReel(target) {
    if (isAnimating || target === currentReel || isModalOpen) return;
    isAnimating = true;

    const wrappingForward  = currentReel === TOTAL - 1 && target === 0;
    const wrappingBackward = currentReel === 0 && target === TOTAL - 1;
    const steps    = (wrappingForward || wrappingBackward) ? TOTAL - 1 : Math.abs(target - currentReel);
    const msPerStep = Math.round(CAROUSEL_MS / steps);

    try {
      if (wrappingForward) {
        // Carousel → animate to clone at pos 5; slide 0 enters from right
        if (reelTrack) reelTrack.style.transform = `translateX(-${TOTAL * 100}%)`;
        // Buttons + dots → jump to 0 immediately
        reelBtns.forEach((b, i) => b.classList.toggle('active', i === 0));
        knobDots.forEach((d, i) => {
          if (i === 0) { d.setAttribute('fill','#3A8A65'); d.setAttribute('stroke','#2D6A4F'); d.setAttribute('filter','url(#led-glow)'); }
          else { d.setAttribute('fill','#243D55'); d.setAttribute('stroke','#243447'); d.removeAttribute('filter'); }
        });
        // Knob → rewind 4→3→2→1→0 over CAROUSEL_MS
        if (knobIndicator) knobIndicator.style.transitionDuration = `${msPerStep}ms`;
        for (let i = TOTAL - 2; i >= 0; i--) {
          knobIndicator.style.transform = `rotate(${STOP_ANGLES[i]}deg)`;
          if (progressArc) progressArc.setAttribute('d', i === 0 ? '' : buildArcPath(ARC_START, STOP_ANGLES[i] - ARC_START));
          await sleep(msPerStep);
        }
        // Silently snap track from clone (5) back to real pos 0
        if (reelTrack) {
          reelTrack.style.transition = 'none';
          reelTrack.style.transform = 'translateX(0)';
          reelTrack.offsetHeight;
          reelTrack.style.transition = '';
        }
        currentReel = 0;

      } else if (wrappingBackward) {
        // Carousel → silently snap to clone pos 5, then animate to pos 4; slide 4 enters from left
        if (reelTrack) {
          reelTrack.style.transition = 'none';
          reelTrack.style.transform = `translateX(-${TOTAL * 100}%)`;
          reelTrack.offsetHeight;
          reelTrack.style.transition = '';
          reelTrack.style.transform = `translateX(-${(TOTAL - 1) * 100}%)`;
        }
        // Buttons + dots → jump to TOTAL-1 immediately
        reelBtns.forEach((b, i) => b.classList.toggle('active', i === TOTAL - 1));
        knobDots.forEach((d, i) => {
          if (i === TOTAL - 1) { d.setAttribute('fill','#3A8A65'); d.setAttribute('stroke','#2D6A4F'); d.setAttribute('filter','url(#led-glow)'); }
          else { d.setAttribute('fill','#243D55'); d.setAttribute('stroke','#243447'); d.removeAttribute('filter'); }
        });
        // Knob → wind forward 0→1→2→3→4 over CAROUSEL_MS
        if (knobIndicator) knobIndicator.style.transitionDuration = `${msPerStep}ms`;
        for (let i = 1; i < TOTAL; i++) {
          knobIndicator.style.transform = `rotate(${STOP_ANGLES[i]}deg)`;
          if (progressArc) progressArc.setAttribute('d', buildArcPath(ARC_START, STOP_ANGLES[i] - ARC_START));
          await sleep(msPerStep);
        }
        currentReel = TOTAL - 1;

      } else {
        // Normal → knob + carousel step in sync, total = CAROUSEL_MS
        const dir = target > currentReel ? 1 : -1;
        if (knobIndicator) knobIndicator.style.transitionDuration = `${msPerStep}ms`;
        while (currentReel !== target) {
          currentReel += dir;
          updateKnobVisuals(currentReel);
          if (reelTrack) reelTrack.style.transform = `translateX(-${currentReel * 100}%)`;
          if (currentReel !== target) await sleep(msPerStep);
        }
      }
    } finally {
      // Always restore transition + unlock — prevents stuck state on any interruption
      if (knobIndicator) knobIndicator.style.transitionDuration = '';
      isAnimating = false;
    }
  }

  // Set initial state
  updateKnobVisuals(0);

  // SVG dot clicks
  knobDots.forEach((dot) => {
    dot.addEventListener('click', () => goToReel(Number(dot.dataset.index)));
  });

  // Reel button clicks
  reelBtns.forEach((btn) => {
    btn.addEventListener('click', () => goToReel(Number(btn.dataset.index)));
  });

  // Carousel swipe — pointer events cover trackpad, mouse drag, and touch
  const reelCarousel = document.getElementById('reel-carousel');
  let swipeStartX = 0, swipeActive = false;
  if (reelCarousel) {
    reelCarousel.addEventListener('pointerdown', e => {
      swipeStartX = e.clientX; swipeActive = true;
      reelCarousel.setPointerCapture(e.pointerId);
    });
    reelCarousel.addEventListener('pointerup', e => {
      if (!swipeActive) return;
      swipeActive = false;
      const dx = e.clientX - swipeStartX;
      if (Math.abs(dx) > 40) {
        const next = dx < 0
          ? (currentReel === TOTAL - 1 ? 0 : currentReel + 1)
          : (currentReel === 0 ? TOTAL - 1 : currentReel - 1);
        goToReel(next);
      }
    });
    reelCarousel.addEventListener('pointercancel', () => { swipeActive = false; });

    // Two-finger trackpad swipe (Mac + Windows precision touchpad → wheel events)
    let wheelAccum = 0, wheelCooldown = false;
    reelCarousel.addEventListener('wheel', e => {
      if (Math.abs(e.deltaX) < Math.abs(e.deltaY)) return;
      e.preventDefault();
      if (wheelCooldown) return;
      wheelAccum += e.deltaX;
      if (Math.abs(wheelAccum) > 60) {
        const next = wheelAccum > 0
          ? (currentReel === TOTAL - 1 ? 0 : currentReel + 1)
          : (currentReel === 0 ? TOTAL - 1 : currentReel - 1);
        goToReel(next);
        wheelAccum = 0;
        wheelCooldown = true;
        setTimeout(() => { wheelCooldown = false; wheelAccum = 0; }, 800);
      }
    }, { passive: false });
  }

  // ── SIGNAL PATH ──
  const rmStops = [
    {
