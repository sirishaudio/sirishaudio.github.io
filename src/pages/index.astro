<!-- Glyph strips are injected inside each section below — see each section -->

<style>
  /* ── GLYPH STRIP: sits inside each section ──
     position:absolute fills the section, pointer-events:none so the strip
     itself doesn't block clicks. Individual .glyph elements opt back in
     with pointer-events:all. z-index:0 puts strip above section bg,
     .section-inner is z-index:1 so content always sits on top. */
  .glyph-strip {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 0;
    overflow: hidden;
  }

  /* Sections need position:relative so the strip is contained */
  #hero-outer,
  .section-pad {
    position: relative;
  }

  /* Content always above glyphs */
  .section-inner,
  .v2-section-inner,
  #contact .itag-wrap {
    position: relative;
    z-index: 1;
  }

  .glyph {
    position: absolute;
    pointer-events: all;
    cursor: default;
    /* filled glyphs use currentColor for fill + stroke */
    color: #2a3d52;
    stroke: #2a3d52;
    fill: none;
    opacity: 0.28;
    transition: opacity 0.25s, color 0.25s, filter 0.25s;
  }
  .glyph:hover {
    opacity: 0.85;
    color: #3A8A65;
    stroke: #3A8A65;
    filter: drop-shadow(0 0 5px rgba(58,138,101,0.35));
  }

  /* Sizes — ~25% smaller than original */
  .g-quarter { width: 14px; height: 35px; }
  .g-beam    { width: 27px; height: 35px; }

  /* ── QUARTER NOTE: single weighted jump ──
     Lifts with slight lean, hangs at peak, drops with weight */
  .g-quarter:hover {
    animation: qjump 0.7s cubic-bezier(0.33, 1, 0.68, 1);
  }
  @keyframes qjump {
    0%   { transform: translateY(0)    rotate(0deg);   }
    28%  { transform: translateY(-11px) rotate(-4deg); }
    52%  { transform: translateY(-13px) rotate(-2deg); } /* hang */
    75%  { transform: translateY(-3px)  rotate(1deg);  } /* fall */
    88%  { transform: translateY(-6px)  rotate(0deg);  } /* small rebound */
    100% { transform: translateY(0)    rotate(0deg);   }
  }

  /* ── BEAMED PAIR: gallop rhythm ──
     Two-beat lurch — accent on first beat, quick second, settles */
  .g-beam:hover {
    animation: bgallop 0.72s cubic-bezier(0.25, 1, 0.5, 1);
  }
  @keyframes bgallop {
    0%   { transform: translateY(0)    rotate(0deg);   }
    18%  { transform: translateY(-10px) rotate(-5deg); } /* beat 1 up */
    33%  { transform: translateY(-4px)  rotate(-2deg); } /* land */
    50%  { transform: translateY(-8px)  rotate(-4deg); } /* beat 2 up */
    65%  { transform: translateY(-2px)  rotate(1deg);  } /* land */
    80%  { transform: translateY(-4px)  rotate(-1deg); } /* small echo */
    100% { transform: translateY(0)    rotate(0deg);   }
  }
</style>

