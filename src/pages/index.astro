---
import Layout from "../layouts/Layout.astro";
import "../styles/global.css";

const gameSD = [
  { title: "Spongebob: Krusty Cook-Off", studio: "Nukebox Studios", year: "2018–2022", desc: "Parameter-driven adaptive music + SFX via Unity & FMOD. 29M+ downloads. Google Play Users' Choice 2020.", tags: ["FMOD","Unity","Adaptive Audio"], note: "200M+ players globally", ios: "https://apps.apple.com/app/spongebob-krusty-cook-off/id1456844652", android: "https://play.google.com/store/apps/details?id=com.nickelodeon.sponge" },
  { title: "Food Truck Chef", studio: "Nukebox Studios", year: "2018–2022", desc: "Full audio pipeline — adaptive music, SFX, and UI sounds for a globally distributed casual title.", tags: ["FMOD","Unity","SFX Pipeline"], note: "", ios: "https://apps.apple.com/app/food-truck-chef/id1213039508", android: "https://play.google.com/store/apps/details?id=com.socialpoint.foodtruckchef" },
  { title: "Room Flip: Home Decor", studio: "Nukebox Studios", year: "2018–2022", desc: "Modular SFX architecture and reactive audio state management for casual mobile.", tags: ["Unity","Modular SFX"], note: "", ios: "", android: "" },
  { title: "Angry Birds Match 3", studio: "Gear Inc. · Tilting Point", year: "2022", desc: "Adaptive audio for a globally distributed IP. High-retention casual gameplay loop design.", tags: ["FMOD","Adaptive Audio"], note: "Global IP", ios: "", android: "" },
  { title: "M&M's Adventure", studio: "Gear Inc. · Tilting Point", year: "2022", desc: "Audio systems for a branded casual title. Applied adaptive audio to high-engagement match-3 gameplay.", tags: ["FMOD","Adaptive Audio"], note: "Global IP", ios: "", android: "" },
  { title: "Milli Match", studio: "Giga Fun Studios", year: "2023–2025", desc: "Modular SFX architecture and parameter-driven music design for match-3 mobile.", tags: ["Unity","Param-Driven"], note: "", ios: "", android: "" },
  { title: "Rani's Case Files", studio: "Giga Fun Studios", year: "2023–2025", desc: "Reactive audio state management and middleware integration for a puzzle mobile title.", tags: ["Unity","Wwise","SFX"], note: "", ios: "", android: "" },
  { title: "Travel Match India", studio: "Giga Fun Studios", year: "2023–2025", desc: "Full audio pipeline for a culturally-themed casual title targeting Indian market.", tags: ["Unity","Adaptive Audio"], note: "", ios: "", android: "" },
  { title: "Ludo Hero", studio: "Qila Games", year: "2023–2025", desc: "Audio design and implementation for a multiplayer mobile board game.", tags: ["Unity","Multiplayer Audio"], note: "", ios: "", android: "" },
];

const gameMusic = [
  { title: "Beat Kingdom", studio: "Sound Designer & Composer", year: "2025–Present", desc: "Real-time adaptive music system with 80–200 BPM dynamic ramping. Parameter-driven states: Combo, Perfect, Strike — designed for scalable emotional player feedback.", tags: ["Procedural Music","Param-Driven","Adaptive"], note: "Active" },
];

const film = [
  { title: "Cinemabandi", studio: "D2R Productions", year: "2019–2020", desc: "Full score, sound design, and foley for an award-winning Telugu feature film. Solo audio director across drama and comedy genres.", tags: ["Film Score","Foley","ADR","Mixing"], note: "Award-winning" },
  { title: "Anthele Kadha Anthele", studio: "Sakala Entertainment", year: "2021–2022", desc: "Composition, SFX, and foley. Full audio production as sole audio director.", tags: ["Film Score","SFX","Foley"], note: "" },
  { title: "Kavyam", studio: "Swaraj Studios", year: "2022–2023", desc: "Background score, sound design, and mixing & mastering for a Telugu drama feature.", tags: ["Film Score","Sound Design","Mixing"], note: "" },
  { title: "Seetharam Sithralu", studio: "Raising Hands Productions", year: "2023", desc: "Solo audio producer — songs, background score, sound design, and M&M.", tags: ["Score","Songs","SFX"], note: "" },
  { title: "E3 (working title)", studio: "Telugu Indie", year: "2024–Present", desc: "Ongoing. Serving as solo producer across songs, background score, sound design, and mixing & mastering.", tags: ["Score","Songs","SFX","Mixing"], note: "Ongoing" },
];

const aiAudio = [
  { title: "Gita Gurukul — AI Sanskrit Eval", studio: "AI Audio Developer", year: "2025–Present", desc: "Web prototype for AI-assisted Sanskrit pronunciation evaluation. Phonetic segmentation and alignment for real-time learner feedback.", tags: ["ML Pipelines","IPA Mapping","Speech Eval","Phonetic Align"], note: "Active" },
  { title: "Sanskrit Phonetics Library", studio: "AI Phonetics Researcher", year: "2026–Present", desc: "Structured IPA-mapped phonetic dataset with articulation features for an API-ready speech and pronunciation platform.", tags: ["IPA Mapping","Dataset","API","Phonetics"], note: "Active" },
];

const listenTracksDef = [
  { title: "Prompt DJ — Experiment", year: "2025", label: "AI Audio",    icon: "🤖", color: "#9B72CF", thumbBg: "linear-gradient(150deg,#0D1823 0%,#1A1430 100%)", desc: "AI-assisted DJ experiment exploring procedural music generation and real-time parameter control.", tags: ["AI","Procedural","Electronic"], url: "https://soundcloud.com/sirishsatyavolu/prompt-dj-experiment" },
  { title: "Contravention",          year: "2016", label: "Composition", icon: "🎹", color: "#3A8A65", thumbBg: "linear-gradient(150deg,#0D1823 0%,#1C2B3A 100%)", desc: "Electronic composition exploring rhythmic tension and melodic counterpoint.", tags: ["Electronic","Composition"], url: "https://soundcloud.com/sirishsatyavolu/contravention-september-15" },
  { title: "Right and Ease",         year: "2016", label: "Composition", icon: "🌊", color: "#4F7EF7", thumbBg: "linear-gradient(150deg,#0D1823 0%,#0D1628 100%)", desc: "Ambient-leaning piece with layered textures and evolving harmonic movement.", tags: ["Ambient","Texture","Composition"], url: "https://soundcloud.com/sirishsatyavolu/right-and-ease" },
  { title: "I Miss You Thrice",      year: "2016", label: "Cinematic",   icon: "🎬", color: "#8A9BB0", thumbBg: "linear-gradient(150deg,#0D1823 0%,#1A1F2A 100%)", desc: "Emotionally driven composition with cinematic undertones and dynamic arc.", tags: ["Cinematic","Composition"], url: "https://soundcloud.com/sirishsatyavolu/i-miss-you-thrice-september-19" },
];

const listenTracks = await Promise.all(listenTracksDef.map(async (t) => {
  try {
    const res = await fetch(`https://soundcloud.com/oembed?url=${encodeURIComponent(t.url)}&format=json`);
    const data = await res.json();
    return { ...t, thumb: data.thumbnail_url ?? null };
  } catch {
    return { ...t, thumb: null };
  }
}));

const reels = [
  { title: "Showreel",        sub: "Scripted · Best of Work",      color: "#3A8A65" },
  { title: "Game Audio",      sub: "Adaptive Music & SFX",         color: "#3A8A65" },
  { title: "UI Sound Design", sub: "One Sound at a Time",          color: "#4F7EF7" },
  { title: "UI FX & Motion",  sub: "Effects & Motion Graphics",    color: "#4F7EF7" },
  { title: "Film & Cinematic",sub: "Movie Works",                  color: "#8A9BB0" },
];
---

<Layout>

<style>
  /* ── RESET ── */
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

  /* ── VIEWPORT LOCK ── */
  :root {
    --nav-h: 4.5rem;
    --panel-h: 44dvh;
    --panel-w: calc(var(--panel-h) * 16 / 9);
    --content-w: var(--panel-w);
    --c-tert: #243D55;
  }
  html { scroll-snap-type: y mandatory; }

  /* ── INFO TAGS ── */
  .itag-wrap { position: relative; }
  .itag { position: absolute; bottom: 8px; right: 8px; z-index: 100; }
  .itag-btn {
    width: 20px; height: 20px; border-radius: 50%;
    border: 1px solid currentColor;
    background: rgba(19,30,42,0.9);
    font-size: 10px; font-weight: 700;
    font-family: 'Lato', sans-serif;
    cursor: pointer; display: flex;
    align-items: center; justify-content: center;
    backdrop-filter: blur(4px);
    transition: transform 0.15s;
    line-height: 1;
  }
  .itag-btn:hover { transform: scale(1.2); }
  .itag-tooltip {
    display: none; position: absolute;
    bottom: 28px; right: 0;
    background: rgba(19,30,42,0.97);
    border: 1px solid #243447; border-radius: 6px;
    padding: 10px 14px; width: 240px;
    font-family: 'Lato', sans-serif; font-size: 11px;
    line-height: 1.7; color: #8A9BB0;
    white-space: pre-wrap; backdrop-filter: blur(8px);
    z-index: 200;
  }
  .itag-tooltip strong { display: block; font-size: 10px; letter-spacing: 0.12em; text-transform: uppercase; margin-bottom: 4px; }
  .itag:hover .itag-tooltip { display: block; }

  /* ── HERO ── */
  #hero-outer {
    position: relative; height: 100dvh; overflow: hidden;
    display: flex; align-items: center;
    scroll-snap-align: start;
  }
  #hero-bg {
    position: absolute; inset: -20%;
    will-change: transform;
    background:
      radial-gradient(ellipse 80% 60% at 70% 30%, rgba(45,106,79,0.18) 0%, transparent 60%),
      radial-gradient(ellipse 60% 80% at 10% 70%, rgba(26,86,219,0.12) 0%, transparent 60%),
      radial-gradient(ellipse 100% 100% at 50% 50%, #0D1823 0%, #131E2A 100%);
  }
  /* studio light glow simulation */
  #hero-bg::before {
    content: '';
    position: absolute; top: -10%; right: 5%;
    width: 500px; height: 500px;
    background: radial-gradient(circle, rgba(58,138,101,0.12) 0%, transparent 65%);
    border-radius: 50%;
  }
  #hero-bg::after {
    content: '';
    position: absolute; bottom: 10%; left: 5%;
    width: 400px; height: 400px;
    background: radial-gradient(circle, rgba(79,126,247,0.09) 0%, transparent 65%);
    border-radius: 50%;
  }
  /* waveform overlay */
  #hero-wave {
    position: absolute; inset: 0;
    opacity: 0.06; pointer-events: none;
  }
  /* grain texture */
  #hero-grain {
    position: absolute; inset: 0;
    opacity: 0.03; pointer-events: none;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noise'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noise)'/%3E%3C/svg%3E");
    background-size: 256px 256px;
  }
  #hero-content {
    position: relative; z-index: 2; will-change: transform;
    width: var(--content-w); max-width: 100%; margin: 0 auto; padding: 0;
  }

  /* image placeholder label */
  .img-ph-label {
    position: absolute; top: 12px; left: 12px;
    font-size: 0.65rem; font-family: 'Lato', sans-serif;
    font-weight: 700; letter-spacing: 0.15em; text-transform: uppercase;
    color: rgba(138,155,176,0.5);
    border: 1px dashed rgba(138,155,176,0.2);
    padding: 3px 8px; border-radius: 3px;
    pointer-events: none;
  }

  /* ── SCROLL REVEAL ── */
  .reveal {
    opacity: 0;
    transform: translateY(32px);
    transition: opacity 0.7s ease, transform 0.7s ease;
  }
  .reveal.visible { opacity: 1; transform: translateY(0); }
  .reveal-delay-1 { transition-delay: 0.1s; }
  .reveal-delay-2 { transition-delay: 0.2s; }
  .reveal-delay-3 { transition-delay: 0.3s; }

  /* ── NAV ── */
  #nav {
    position: fixed; top: 0; left: 0; right: 0; z-index: 50;
    padding: 1.1rem 2rem;
    display: grid; grid-template-columns: 1fr auto 1fr; align-items: center;
    transition: background 0.4s ease, border-color 0.4s ease;
    border-bottom: 1px solid transparent;
  }
  .nav-left { display: flex; align-items: center; }
  .nav-icon { display: flex; align-items: center; text-decoration: none; opacity: 0.9; transition: opacity 0.2s; }
  .nav-icon:hover { opacity: 1; }
  .nav-center { display: flex; justify-content: center; }
  .nav-wordmark { font-family: 'Montserrat', sans-serif; font-weight: 800; font-size: 0.95rem; letter-spacing: 0.1em; color: #F4F6F8; text-decoration: none; }
  .nav-wordmark span { color: #3A8A65; }
  .nav-right { display: flex; align-items: center; justify-content: flex-end; gap: 1.5rem; }
  .nav-links { display: flex; gap: 0.4rem; }
  .toggle-wrap { display: flex; flex-direction: column; align-items: center; gap: 5px; }
  .nav-toggle { width: 36px; height: 36px; background: #0D1823; border: 1px solid #1C2B3A; border-radius: 5px; cursor: pointer; display: flex; align-items: center; justify-content: center; padding: 0; box-shadow: inset 0 2px 3px rgba(0,0,0,0.5), 0 1px 0 rgba(255,255,255,0.03); transition: border-color 0.15s; flex-shrink: 0; }
  .nav-toggle:hover { border-color: #243447; }
  .nav-toggle:active { box-shadow: inset 0 3px 5px rgba(0,0,0,0.7); transform: translateY(0.5px); }
  .toggle-icon { display: flex; align-items: center; justify-content: center; color: #4a5f78; transition: color 0.2s; }
  .nav-toggle:hover .toggle-icon { color: #8A9BB0; }
  #mode-toggle.mode-dark .toggle-icon { color: #F0F4F8; }
  #mode-toggle.mode-dark:hover .toggle-icon { color: #8A9BB0; }
  .toggle-led { width: 5px; height: 5px; border-radius: 50%; background: #060d15; border: 1px solid #0a1018; transition: background 0.25s, box-shadow 0.25s; flex-shrink: 0; }
  .toggle-led.on-green { background: #22c55e; box-shadow: 0 0 4px rgba(34,197,94,0.9), 0 0 8px rgba(34,197,94,0.3); }
  .toggle-led.on-white { background: rgba(240,244,248,0.92); box-shadow: 0 0 4px rgba(240,244,248,0.8), 0 0 10px rgba(240,244,248,0.2); }

  /* ── NAV LINKS = ui-btn prefab ── */
  .nav-links a {
    display: inline-flex; align-items: center;
    background: #0D1823;
    border: 1px solid #1C2B3A;
    border-radius: 5px;
    padding: 0.3rem 0.75rem;
    font-family: 'Montserrat', sans-serif;
    font-size: 0.6rem; font-weight: 700;
    letter-spacing: 0.1em; text-transform: uppercase;
    color: #4a5f78; text-decoration: none; cursor: pointer;
    box-shadow: inset 0 2px 3px rgba(0,0,0,0.5);
    transition: border-color 0.2s, box-shadow 0.2s, color 0.2s;
  }
  .nav-links a:hover { color: #8A9BB0; border-color: #243447; }
  .nav-links a.nav-active {
    color: #3A8A65;
    border-color: #2D6A4F;
    box-shadow: inset 0 2px 3px rgba(0,0,0,0.5), 0 0 6px rgba(45,106,79,0.55), 0 0 14px rgba(45,106,79,0.18);
  }

  /* ── REEL SELECTOR BUTTONS ── */
  .reel-btn-row { display: flex; gap: 0.4rem; flex-wrap: wrap; margin-bottom: 0.875rem; }
  .reel-btn {
    background: #0D1823;
    border: 1px solid #1C2B3A;
    border-radius: 5px;
    padding: 0.3rem 0.75rem;
    font-family: 'Montserrat', sans-serif;
    font-size: 0.6rem; font-weight: 700;
    letter-spacing: 0.1em; text-transform: uppercase;
    color: #4a5f78; cursor: pointer;
    box-shadow: inset 0 2px 3px rgba(0,0,0,0.5);
    transition: border-color 0.2s, box-shadow 0.2s, color 0.2s;
  }
  .reel-btn:hover { color: #8A9BB0; border-color: #243447; }
  .reel-btn.active {
    color: #3A8A65;
    border-color: #2D6A4F;
    box-shadow: inset 0 2px 3px rgba(0,0,0,0.5),
                0 0 6px rgba(45,106,79,0.55),
                0 0 14px rgba(45,106,79,0.18);
  }

  /* ── REEL CAROUSEL ── */
  .reel-carousel { overflow: hidden; border-radius: 8px; touch-action: pan-y; }
  .reel-track { display: flex; transition: transform 0.35s cubic-bezier(0.4,0,0.2,1); }
  .reel-slide { min-width: 100%; }

  /* ── KNOB ── */
  .knob-zone { display: flex; flex-direction: column; align-items: center; gap: 1.25rem; margin-top: 2rem; }
  .knob-svg { cursor: grab; user-select: none; -webkit-user-select: none; }
  .knob-svg:active { cursor: grabbing; }
  #knob-indicator { transform-origin: 80px 72px; transition: transform 0.35s cubic-bezier(0.4,0,0.2,1); }

  /* ── REEL — fluid 44dvh layout ── */
  #reel { padding-top: calc(var(--nav-h) + 1rem); }
  #reel .section-inner {
    width: var(--content-w);
    max-width: 100%;
    margin: 0 auto;
    padding: 0;
  }
  #reel .knob-zone { margin-top: 1rem; }

  /* ── REEL DOTS ── */
  .reel-dots { display: flex; gap: 1rem; align-items: flex-start; }
  .reel-dot { width: 24px; display: flex; flex-direction: column; align-items: center; gap: 5px; background: none; border: none; cursor: pointer; padding: 0; }
  .dot-body { width: 8px; height: 8px; border-radius: 50%; background: #0D1823; border: 1px solid #1C2B3A; transition: border-color 0.2s, background 0.2s; }
  .reel-dot.active .dot-body { background: #111d2b; border-color: #2D6A4F; }
  .dot-led { width: 4px; height: 4px; border-radius: 50%; background: #060d15; transition: background 0.25s, box-shadow 0.25s; }
  .reel-dot.active .dot-led { background: #3A8A65; box-shadow: 0 0 3px rgba(58,138,101,0.8); }
  .dot-label { font-family: 'Montserrat', sans-serif; font-size: 0.52rem; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; color: #243447; transition: color 0.2s; white-space: nowrap; }
  .reel-dot.active .dot-label { color: #3A8A65; }

  /* ── HERO QUOTE ── */
  .hero-quote { font-family: 'Lato', sans-serif; font-style: italic; font-size: 1rem; color: #B7D5C4; line-height: 1.6; padding-left: 1rem; border-left: 2px solid #2D6A4F; margin-bottom: 1.5rem; max-width: 400px; }
  .hero-divider { border: none; border-top: 1px solid #1C2B3A; margin: 2rem 0; }

  /* ── SECTION STRUCTURE ── */
  .section-inner { max-width: 1100px; margin: 0 auto; padding: 0 2rem; }
  /* Each section = exactly one viewport. Content starts below nav. */
  .section-pad {
    height: 100dvh; overflow: hidden;
    display: flex; flex-direction: column; justify-content: center;
    padding-top: var(--nav-h);
    scroll-snap-align: start;
  }
  .section-alt { background: #1C2B3A; }
  /* Sections with their own dense internal layouts — align to top, not centered */
  #work   { justify-content: center; padding-top: calc(var(--nav-h) + 1rem); }
  #listen { justify-content: flex-start; padding-top: calc(var(--nav-h) + 2.5rem); }
  #skills { justify-content: flex-start; padding-top: calc(var(--nav-h) + 2.5rem); }
  /* Work + Listen section inner = flex column, locked to --content-w */
  #work .section-inner,
  #listen .section-inner { display: flex; flex-direction: column; width: var(--content-w); max-width: 100%; margin: 0 auto; padding: 0; }
  .eyebrow { font-size: 0.72rem; font-family: 'Montserrat', sans-serif; font-weight: 700; letter-spacing: 0.22em; text-transform: uppercase; color: #3A8A65; margin-bottom: 0.6rem; }
  .section-h2 { font-family: 'Montserrat', sans-serif; font-size: clamp(1.7rem, 2.8vw, 2.4rem); font-weight: 800; color: #F4F6F8; margin-bottom: 0.75rem; line-height: 1.1; }
  .section-sub { font-family: 'Lato', sans-serif; font-size: 0.95rem; color: #8A9BB0; line-height: 1.85; max-width: 440px; }

  /* ── LISTEN SECTION ── */
  .listen-tray {
    height: var(--panel-h); flex-shrink: 0;
    position: relative; overflow: hidden;
    width: 100%;
    background: var(--c-tert);
    border-radius: 10px;
    border: 1px solid #1C2B3A;
    box-shadow: 0 1px 0 rgba(255,255,255,0.04);
    padding: 0.6rem;
  }
  .listen-cards {
    display: flex; flex-direction: column;
    gap: 0.5rem; height: calc(100% + 28px); /* +28px compensates for -14px top + bottom negative margins */
    overflow-y: auto; scrollbar-width: none;
    padding: 14px 6px; margin: -14px -6px; /* breathing room: 14px v / 6px h for shadow + scale(1.01) */
  }
  .listen-cards::-webkit-scrollbar { display: none; }
  .listen-card {
    flex-shrink: 0;
    min-height: 8rem;
    display: flex; flex-direction: row;
    background: #131E2A; border: 1px solid #243447; border-radius: 8px;
    overflow: hidden;
    transition: transform 0.22s ease, box-shadow 0.22s ease;
    box-shadow: 0 2px 8px rgba(0,0,0,0.35);
  }
  .listen-card:hover {
    transform: scale(1.01);
    box-shadow: 0 3px 10px rgba(0,0,0,0.5), 0 0 10px rgba(58,138,101,0.16);
  }
  /* Thumb — inset, square, rounded */
  .lc-thumb-wrap {
    flex-shrink: 0;
    padding: 4px 0 4px 4px;
    display: flex; align-items: center;
  }
  .lc-thumb {
    width: calc(8rem - 8px);
    height: calc(8rem - 8px); /* square — matches card min-height minus top+bottom gap */
    flex-shrink: 0;
    position: relative;
    border-radius: 6px; overflow: hidden;
    background: #0D1823;
    display: flex; flex-direction: column;
    align-items: center; justify-content: center;
  }
  .lc-thumb-bg  { position: absolute; inset: 0; }
  .lc-thumb-img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; opacity: 0.85; }
  .lc-thumb-icon  { position: relative; z-index: 1; font-size: 1.1rem; }
  .lc-thumb-label { position: relative; z-index: 1; font-size: 0.44rem; font-family: 'Montserrat', sans-serif; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: rgba(255,255,255,0.45); margin-top: 0.2rem; }
  /* Body */
  .lc-body   { flex: 1; display: flex; flex-direction: column; min-width: 0; min-height: 0; position: relative; }
  .lc-accent { height: 2px; background: var(--cc); opacity: 0.6; flex-shrink: 0; }
  /* Row 1: label + year */
  .lc-header { display: flex; align-items: center; justify-content: space-between; padding: 0.35rem 0.65rem 0.2rem; flex-shrink: 0; }
  .lc-label  { font-size: 0.58rem; font-family: 'Montserrat', sans-serif; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: var(--cc); }
  .lc-year   { font-size: 0.6rem; font-family: 'Lato', sans-serif; color: #8A9BB0; }
  /* Row 2: play btn + right column */
  .lc-main { display: flex; flex-direction: row; align-items: stretch; gap: 0.6rem; padding: 0 0.65rem 0.3rem; flex: 1; min-height: 0; }
  .lc-play-btn {
    flex-shrink: 0;
    width: 2.8rem; height: 2.8rem;
    align-self: center;
    border-radius: 50%;
    background: var(--cc); border: none; cursor: pointer;
    display: flex; align-items: center; justify-content: center;
    color: #0D1823;
    transition: transform 0.15s ease, opacity 0.15s ease;
  }
  .lc-play-btn:hover { transform: scale(1.06); opacity: 0.9; }
  .lc-play-btn svg { width: 42%; height: 42%; flex-shrink: 0; }
  .lc-icon-play  { display: block; }
  .lc-icon-pause { display: none; }
  .lc-play-btn.playing .lc-icon-play  { display: none; }
  .lc-play-btn.playing .lc-icon-pause { display: block; }
  /* Right column */
  .lc-track-right { flex: 1; display: flex; flex-direction: column; justify-content: space-between; min-width: 0; padding-top: 0.1rem; }
  .lc-title { font-size: 0.82rem; font-family: 'Montserrat', sans-serif; font-weight: 700; color: #F4F6F8; flex-shrink: 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .lc-progress-wrap { flex-shrink: 0; display: flex; flex-direction: column; gap: 0.22rem; }
  .lc-progress-bar  { height: 3px; border-radius: 2px; background: #243447; cursor: pointer; overflow: hidden; }
  .lc-progress-fill { height: 100%; width: 0%; border-radius: 2px; background: var(--cc); transition: width 0.1s linear; pointer-events: none; }
  .lc-time-row { display: flex; justify-content: space-between; }
  .lc-time-cur, .lc-time-dur { font-size: 0.56rem; font-family: 'Lato', sans-serif; color: #8A9BB0; }
  .lc-desc  { font-size: 0.65rem; font-family: 'Lato', sans-serif; color: #8A9BB0; line-height: 1.45; flex: 1; overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; }
  /* Row 3: tags */
  .lc-tags  { display: flex; gap: 0.22rem; flex-wrap: wrap; padding: 0 0.65rem 0.35rem; flex-shrink: 0; }
  .lc-tag   { font-size: 0.56rem; font-family: 'Lato', sans-serif; padding: 0.12rem 0.36rem; background: #0D1823; border-radius: 3px; color: var(--cc); border: 1px solid #1C2B3A; }
  /* Hidden SC iframe */
  .lc-sc-iframe { position: absolute; width: 1px; height: 1px; opacity: 0; pointer-events: none; top: 0; left: 0; border: none; }

  /* ── WORK SECTION ── */
  .work-hdr { flex-shrink: 0; margin-bottom: 0.5rem; }
  .work-hdr .section-sub { margin-bottom: 1.5rem; }
  /* Category buttons — button prefab, same row as reel-btn-row */
  .work-btn-row { display: flex; gap: 0.4rem; flex-shrink: 0; margin-bottom: 1rem; }
  .work-btn {
    display: inline-flex; align-items: center;
    background: #0D1823; border: 1px solid #1C2B3A; border-radius: 5px;
    padding: 0.3rem 0.75rem;
    font-family: 'Montserrat', sans-serif; font-size: 0.6rem; font-weight: 700;
    letter-spacing: 0.1em; text-transform: uppercase;
    color: #4a5f78; cursor: pointer; white-space: nowrap;
    box-shadow: inset 0 2px 3px rgba(0,0,0,0.5);
    transition: border-color 0.2s, box-shadow 0.2s, color 0.2s;
  }
  .work-btn:hover { color: #8A9BB0; border-color: #243447; }
  .work-btn.active {
    color: #3A8A65; border-color: #2D6A4F;
    box-shadow: inset 0 2px 3px rgba(0,0,0,0.5), 0 0 6px rgba(45,106,79,0.55), 0 0 14px rgba(45,106,79,0.18);
  }
  /* Outer tray wrapper — holds inset shadow above cards */
  .work-tray-outer {
    position: relative;
    border-radius: 10px;
    isolation: isolate; /* stacking context so ::after renders above inner content */
  }
  .work-tray-outer::after {
    content: '';
    position: absolute; inset: 0;
    border-radius: 10px;
    box-shadow:
      inset 0 10px 20px rgba(0,0,0,0.18),
      inset 0 -10px 20px rgba(0,0,0,0.14);
    pointer-events: none;
    z-index: 1;
  }
  /* Cards scroll area — physical showcase tray */
  .work-cards-wrap {
    height: var(--panel-h); flex-shrink: 0;
    position: relative; overflow: hidden;
    width: 100%;
    background: var(--c-tert);
    border-radius: 10px;
    border: 1px solid #1C2B3A;
    box-shadow: 0 1px 0 rgba(255,255,255,0.04);
    padding: 0.6rem;
  }
  /* Panel crossfade */
  .work-panels {
    height: 100%; width: 100%; transition: opacity 0.15s ease;
    --fl: black; --fr: transparent; /* fl/fr = left/right fade start color; transparent = fade on, black = off */
    mask-image:
      linear-gradient(to right, var(--fl) 0%, black 5%, black 95%, var(--fr) 100%),
      linear-gradient(to bottom, transparent 0%, black 2%, black 98%, transparent 100%);
    mask-composite: intersect;
    -webkit-mask-image:
      linear-gradient(to right, var(--fl) 0%, black 5%, black 95%, var(--fr) 100%),
      linear-gradient(to bottom, transparent 0%, black 2%, black 98%, transparent 100%);
    -webkit-mask-composite: source-in;
  }
  .work-panels.fading { opacity: 0; }
  /* Each category panel = horizontal scroll row */
  .work-panel {
    display: none; flex-direction: row;
    gap: 1.25rem;
    overflow-x: auto; /* forces overflow-y: auto per CSS spec */
    scrollbar-width: none;
    align-items: center;
    /* Breathing room: 14px v so scale(1.02) + shadow aren't clipped top/bottom */
    padding: 14px 0;
    height: calc(100% + 28px);
    margin: -14px 0;
  }
  .work-panel.active { display: flex; }
  .work-panel::-webkit-scrollbar { display: none; }
  /* Project card — playing-card 5:7 ratio, floats in tray */
  .proj-card-v {
    flex-shrink: 0;
    width: calc((var(--panel-h) - 3rem - 2px) * 5 / 7);
    height: calc(var(--panel-h) - 3rem - 2px); /* -3rem = fixed visual margin, -2px = tray border */
    display: flex; flex-direction: column;
    background: #1C2B3A; border: 1px solid #243447;
    border-radius: 8px; overflow: hidden;
    transition: transform 0.22s ease, box-shadow 0.22s ease;
    position: relative; cursor: pointer;
    box-shadow: 0 2px 8px rgba(0,0,0,0.35);
  }
  .proj-card-v:hover {
    transform: scale(1.02);
    box-shadow: 0 3px 10px rgba(0,0,0,0.5), 0 0 10px rgba(58,138,101,0.16);
  }
  .pcv-accent { height: 2px; background: var(--cc); opacity: 0.6; flex-shrink: 0; }
  .pcv-thumb {
    flex-shrink: 0; height: 120px; background: #0D1823;
    position: relative; overflow: hidden;
    display: flex; align-items: center; justify-content: center;
  }
  .pcv-thumb-icon { font-size: 1.6rem; opacity: 0.2; }
  .pcv-thumb-label {
    position: absolute; bottom: 8px; left: 50%; transform: translateX(-50%);
    font-size: 0.58rem; font-family: 'Montserrat', sans-serif;
    font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase;
    color: var(--cc); opacity: 0.35; white-space: nowrap;
  }
  .pcv-note {
    position: absolute; top: 8px; right: 8px;
    font-size: 0.58rem; font-family: 'Montserrat', sans-serif;
    font-weight: 700; letter-spacing: 0.1em;
    color: var(--cc); background: rgba(13,24,35,0.88);
    padding: 2px 7px; border-radius: 3px; border: 1px solid var(--cc);
  }
  .pcv-body {
    flex: 1; min-height: 0; padding: 0.9rem 1rem 1rem;
    display: flex; flex-direction: column; overflow: hidden;
  }
  .pcv-meta { display: flex; justify-content: space-between; margin-bottom: 0.3rem; flex-shrink: 0; }
  .pcv-studio { font-size: 0.68rem; font-family: 'Lato', sans-serif; color: #8A9BB0; }
  .pcv-year { font-size: 0.65rem; font-family: 'Lato', sans-serif; color: #8A9BB0; }
  .pcv-title { font-family: 'Montserrat', sans-serif; font-size: 0.88rem; font-weight: 700; color: #F4F6F8; margin-bottom: 0.4rem; line-height: 1.3; flex-shrink: 0; }
  .pcv-desc {
    font-size: 0.76rem; font-family: 'Lato', sans-serif; color: #8A9BB0;
    line-height: 1.65; flex: 1; overflow: hidden;
    display: -webkit-box; -webkit-line-clamp: 5; -webkit-box-orient: vertical;
  }
  .pcv-tags { display: flex; gap: 0.3rem; flex-wrap: wrap; margin-top: 0.6rem; flex-shrink: 0; }
  .pcv-tag { font-size: 0.62rem; font-family: 'Lato', sans-serif; padding: 0.18rem 0.45rem; background: #0D1823; border-radius: 3px; color: var(--ct); border: 1px solid #1C2B3A; }
  /* Horizontal scroll glows — same ellipse pattern as Signal Path, rotated */
  .work-glow {
    position: absolute; top: 0; bottom: 0; width: 80px;
    pointer-events: none; opacity: 0;
    transition: opacity 1s ease; z-index: 10;
  }
  .work-glow.visible { opacity: 1; }
  .work-glow-left {
    left: 0;
    background: radial-gradient(ellipse 100% 55% at -30% 50%, rgba(58,138,101,0.22) 0%, transparent 100%);
  }
  .work-glow-right {
    right: 0;
    background: radial-gradient(ellipse 100% 55% at 130% 50%, rgba(58,138,101,0.22) 0%, transparent 100%);
  }
  /* Work knob zone — mirrors reel knob-zone placement */
  .work-knob-zone {
    display: flex; justify-content: center; align-items: center;
    margin-top: 1rem; flex-shrink: 0;
  }

  .listen-knob-zone {
    display: flex; justify-content: center; align-items: center;
    margin-top: 1rem; flex-shrink: 0;
  }
  #lc-indicator { transform-origin: 80px 72px; transition: transform 0.35s cubic-bezier(0.4,0,0.2,1); }

  /* Light mode overrides */
  html.light-mode .work-btn { background: var(--c-deep); border-color: var(--c-border); color: var(--c-text-3); }
  html.light-mode .work-btn.active { color: var(--c-green); border-color: var(--c-green-dk); }
  html.light-mode .work-cards-wrap { background: #D8E8F0; border-color: var(--c-border); box-shadow: 0 1px 0 rgba(255,255,255,0.6); }
  html.light-mode .proj-card-v { background: var(--c-surface); border-color: var(--c-border); box-shadow: 0 4px 16px rgba(0,0,0,0.08), 0 2px 4px rgba(0,0,0,0.12); }
  html.light-mode .pcv-studio, html.light-mode .pcv-year, html.light-mode .pcv-desc { color: var(--c-text-2); }
  html.light-mode .pcv-title { color: var(--c-text-1); }
  html.light-mode .pcv-tag { background: var(--c-elevated); border-color: var(--c-border); color: var(--c-text-2); }

  /* ── CARD EXPAND MODAL ── */
  .card-modal-backdrop {
    position: fixed; inset: 0; z-index: 200;
    background: rgba(8,14,20,0.82);
    backdrop-filter: blur(6px);
    display: flex; align-items: center; justify-content: center;
    opacity: 0; pointer-events: none;
    transition: opacity 0.25s ease;
  }
  .card-modal-backdrop.open { opacity: 1; pointer-events: all; }
  .card-modal-panel {
    position: relative; display: flex; flex-direction: row;
    width: min(820px, 92vw); max-height: 82dvh;
    background: #0D1823; border: 1px solid #243447; border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 24px 64px rgba(0,0,0,0.85), 0 0 40px rgba(58,138,101,0.1), 0 -1px 0 rgba(255,255,255,0.04);
    transform: scale(0.88);
    transition: transform 0.28s cubic-bezier(0.34,1.28,0.64,1);
  }
  .card-modal-backdrop.open .card-modal-panel { transform: scale(1); }
  .card-modal-close {
    position: absolute; top: 0.75rem; right: 0.75rem; z-index: 10;
    background: rgba(13,24,35,0.9); border: 1px solid #243447;
    color: #8A9BB0; font-size: 0.82rem;
    width: 28px; height: 28px; border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
    cursor: pointer; transition: color 0.15s, border-color 0.15s;
  }
  .card-modal-close:hover { color: #F4F6F8; border-color: #3A8A65; }
  .cm-visual {
    flex-shrink: 0; width: 190px; display: flex; flex-direction: column;
  }
  .cm-thumb {
    flex: 1; position: relative; background: #0D1823;
    display: flex; align-items: center; justify-content: center;
    flex-direction: column; gap: 0.5rem; overflow: hidden;
  }
  .cm-thumb-bg { position: absolute; inset: 0; }
  .cm-thumb-icon { font-size: 2.4rem; opacity: 0.22; position: relative; }
  .cm-thumb-label {
    font-size: 0.6rem; font-family: 'Montserrat', sans-serif;
    font-weight: 700; letter-spacing: 0.16em; text-transform: uppercase;
    opacity: 0.4; position: relative;
  }
  .cm-accent { height: 3px; flex-shrink: 0; }
  .cm-content {
    flex: 1; min-width: 0; padding: 1.5rem 1.5rem 1.25rem;
    display: flex; flex-direction: column; overflow-y: auto;
  }
  .cm-note {
    display: inline-block; align-self: flex-start;
    font-size: 0.6rem; font-family: 'Montserrat', sans-serif; font-weight: 700;
    letter-spacing: 0.1em; padding: 2px 8px; border-radius: 3px; border: 1px solid;
    margin-bottom: 0.75rem;
  }
  .cm-note:empty { display: none; }
  .cm-meta { display: flex; justify-content: space-between; margin-bottom: 0.35rem; }
  .cm-studio, .cm-year { font-size: 0.72rem; font-family: 'Lato', sans-serif; color: #8A9BB0; }
  .cm-title {
    font-family: 'Montserrat', sans-serif; font-size: 1.3rem; font-weight: 700;
    color: #F4F6F8; margin-bottom: 0.65rem; line-height: 1.25;
  }
  .cm-desc {
    font-size: 0.82rem; font-family: 'Lato', sans-serif; color: #8A9BB0;
    line-height: 1.7; flex: 1;
  }
  .cm-tags { display: flex; gap: 0.35rem; flex-wrap: wrap; margin-top: 1rem; }
  .cm-tag {
    font-size: 0.65rem; font-family: 'Lato', sans-serif;
    padding: 0.22rem 0.5rem; background: #131E2A;
    border-radius: 3px; color: #8A9BB0; border: 1px solid #1C2B3A;
  }
  .cm-links { display: flex; gap: 0.5rem; margin-top: 1rem; flex-shrink: 0; flex-wrap: wrap; }
  .cm-link {
    display: inline-flex; align-items: center; gap: 0.4rem;
    font-size: 0.72rem; font-family: 'Lato', sans-serif; font-weight: 700;
    padding: 0.4rem 0.9rem; border-radius: 5px;
    border: 1px solid #3A8A65; color: #3A8A65;
    text-decoration: none; background: rgba(58,138,101,0.08);
    transition: background 0.15s, color 0.15s;
  }
  .cm-link:hover { background: rgba(58,138,101,0.18); color: #5AAF85; }

  /* ── REEL / LISTEN ── */
  .ph-video {
    width: 100%; aspect-ratio: 16/9;
    background: #0D1823; border: 1px dashed #243447;
    border-radius: 8px; display: flex; flex-direction: column;
    align-items: center; justify-content: center; gap: 1rem;
    position: relative; overflow: hidden;
  }
  .ph-play {
    width: 52px; height: 52px; border-radius: 50%;
    border: 1.5px solid currentColor;
    display: flex; align-items: center; justify-content: center;
    position: relative; z-index: 1;
    transition: transform 0.2s;
  }
  .ph-video:hover .ph-play { transform: scale(1.1); }
  .ph-sc {
    width: 100%; height: 160px; background: #0D1823;
    border: 1px dashed #243447; border-radius: 8px;
    display: flex; align-items: center; justify-content: center; gap: 1.5rem;
  }

  /* ── PROFILE AVATAR ── */
  .ph-avatar {
    width: 140px; height: 140px; border-radius: 50%;
    background: #1C2B3A; border: 2px solid #243447;
    display: flex; align-items: center; justify-content: center;
    font-family: 'Montserrat', sans-serif;
    font-size: 2.2rem; font-weight: 800; color: #3A8A65;
    flex-shrink: 0;
  }

  /* ── SIGNAL PATH ── */
  .roadmap-wrap {
    --rm-h: 16rem; /* LOCKED — track height = body height. Do not change without explicit request. */
    display: grid;
    grid-template-columns: 1fr auto;
    grid-template-rows: auto auto;
    column-gap: 3.5rem; row-gap: 0.6rem;
    margin-top: 3rem; align-items: start;
  }
  /* Row 1: year heading spans content col only — fader col stays empty */
  .roadmap-year-num {
    grid-column: 1 / 2; grid-row: 1 / 2;
    font-family: 'Montserrat', sans-serif; font-size: clamp(3rem,6vw,4.5rem);
    font-weight: 800; color: #3A8A65; line-height: 1;
  }
  /* Row 2: body + fader aligned together */
  .roadmap-pane { grid-column: 1 / 2; grid-row: 2 / 3; transition: opacity 0.18s ease; position: relative; }
  .roadmap-pane.fading { opacity: 0; }
  /* Scroll glows — ellipse overlays, pointer-events off so they don't block text */
  .rm-glow {
    position: absolute; left: 0; right: 0; height: 72px;
    pointer-events: none; opacity: 0;
    transition: opacity 1s ease; z-index: 2;
  }
  .rm-glow.visible { opacity: 1; }
  .rm-glow-top {
    top: 0;
    background: radial-gradient(ellipse 55% 100% at 50% -30%, rgba(58,138,101,0.22) 0%, transparent 100%);
  }
  .rm-glow-bot {
    bottom: 0;
    background: radial-gradient(ellipse 55% 100% at 50% 130%, rgba(58,138,101,0.22) 0%, transparent 100%);
  }
  /* Scrollable body — native scrollbar hidden, replaced by overlay */
  .roadmap-body {
    height: var(--rm-h); overflow-y: auto;
    padding-right: 0.75rem;
    scrollbar-width: none;
  }
  .roadmap-body::-webkit-scrollbar { display: none; }
  /* Custom overlay scrollbar */
  .rm-scrollbar {
    position: absolute; right: 0; top: 0; bottom: 0;
    width: 2px; z-index: 4; pointer-events: none;
    opacity: 0; transition: opacity 0.3s ease;
  }
  .rm-scrollbar.visible { opacity: 1; }
  .rm-scrollbar-thumb {
    position: absolute; right: 0; width: 2px;
    background: #2D6A4F; border-radius: 1px;
  }
  html.light-mode .rm-scrollbar-thumb { background: var(--c-green-dk); }
  .roadmap-era { font-family: 'Montserrat', sans-serif; font-size: 0.65rem; font-weight: 700; letter-spacing: 0.18em; text-transform: uppercase; color: #8A9BB0; margin-bottom: 1rem; }
  .roadmap-synopsis { font-family: 'Lato', sans-serif; font-size: 0.93rem; color: #8A9BB0; line-height: 1.85; margin-bottom: 1.75rem; max-width: 520px; }
  .roadmap-skills { display: flex; flex-direction: column; gap: 1rem; }
  :global(.roadmap-cat) { }
  :global(.roadmap-cat-label) { font-family: 'Montserrat', sans-serif; font-size: 0.58rem; font-weight: 700; letter-spacing: 0.16em; text-transform: uppercase; color: #3A8A65; margin-bottom: 0.4rem; }
  :global(.roadmap-tags) { display: flex; flex-wrap: wrap; gap: 0.3rem; }
  :global(.roadmap-tag) { font-size: 0.72rem; font-family: 'Lato', sans-serif; padding: 0.22rem 0.55rem; background: #131E2A; border: 1px solid #1C2B3A; border-radius: 3px; color: #8A9BB0; }

  /* ── FADER: 3 columns (track | dots | years) — explicitly row 2, aligned with body ── */
  .roadmap-fader { grid-column: 2 / 3; grid-row: 2 / 3; display: flex; flex-direction: row; align-items: flex-start; gap: 0.6rem; position: sticky; top: var(--nav-h); }

  /* Col 1 — track + thumb. Height locked = --rm-h */
  .rm-track-col {
    position: relative; width: 17px; height: var(--rm-h);
    flex-shrink: 0; cursor: grab;
  }
  .rm-track-col:active { cursor: grabbing; }
  .roadmap-track-line { position: absolute; left: 50%; top: 0; bottom: 0; width: 2px; background: #1C2B3A; transform: translateX(-50%); border-radius: 1px; pointer-events: none; }
  .roadmap-track-fill { position: absolute; left: 50%; bottom: 0; width: 2px; background: #2D6A4F; transform: translateX(-50%); border-radius: 1px; pointer-events: none; filter: url(#led-glow); transition: height 0.35s cubic-bezier(0.4,0,0.2,1); }
  .rm-thumb {
    position: absolute; left: 50%; transform: translate(-50%, -50%);
    width: 17px; height: 40px;
    background: #0D1823; border: 1px solid #1C2B3A; border-radius: 3px;
    cursor: grab; z-index: 3;
    display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 2px;
    box-shadow: inset 0 0 0 1px rgba(36,52,71,0.6), 0 2px 8px rgba(0,0,0,0.6);
    transition: top 0.35s cubic-bezier(0.4,0,0.2,1); touch-action: none;
  }
  .rm-thumb:active { cursor: grabbing; }
  .rm-thumb-grip { width: 8px; height: 1px; background: #8A9BB0; border-radius: 1px; opacity: 0.5; }
  .rm-thumb-grip:nth-child(2) { opacity: 0.85; }
  .rm-thumb-grip:nth-child(3) { opacity: 0.5; }

  /* Col 2 — dots */
  .rm-dots-col {
    display: flex; flex-direction: column; justify-content: space-between; align-items: center;
    height: var(--rm-h); width: 14px; flex-shrink: 0;
  }
  /* :global because dots + year labels are injected via JS and don't get Astro's scoped cid attr */
  :global(.rm-dot) {
    width: 7px; height: 7px; border-radius: 50%;
    background: #8A9BB0; border: 1px solid #8A9BB0;
    transition: background 0.2s, border-color 0.2s, box-shadow 0.2s;
    cursor: pointer; flex-shrink: 0;
  }
  :global(.rm-dot.active) {
    background: #3A8A65; border-color: #2D6A4F;
    box-shadow: 0 0 5px rgba(58,138,101,0.8), 0 0 12px rgba(58,138,101,0.4);
  }

  /* Col 3 — year buttons (matches nav/reel button prefab) */
  .rm-years-col {
    display: flex; flex-direction: column; justify-content: space-between;
    height: var(--rm-h);
  }
  :global(.rm-year-label) {
    display: inline-flex; align-items: center;
    background: #0D1823; border: 1px solid #1C2B3A; border-radius: 5px;
    padding: 0.3rem 0.75rem;
    font-family: 'Montserrat', sans-serif; font-size: 0.6rem; font-weight: 700;
    letter-spacing: 0.1em; text-transform: uppercase;
    color: #4a5f78; cursor: pointer; white-space: nowrap;
    box-shadow: inset 0 2px 3px rgba(0,0,0,0.5);
    transition: border-color 0.2s, box-shadow 0.2s, color 0.2s;
  }
  :global(.rm-year-label:hover) { color: #8A9BB0; border-color: #243447; }
  :global(.rm-year-label.active) {
    color: #3A8A65; border-color: #2D6A4F;
